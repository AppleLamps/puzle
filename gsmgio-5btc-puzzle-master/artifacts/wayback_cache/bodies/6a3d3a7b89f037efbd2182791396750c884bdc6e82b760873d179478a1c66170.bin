ket.do_surplus_selling\"\n        label=\"Enable surplus selling\"\n        @change=\"switchMarketSurplus($event, market)\"\n      ></v-switch>\n      <v-text-field\n        v-if=\"market.enabled && user.subscription_name !== 'Herring'\"\n        v-model=\"market.surplus_min_sell_price\"\n        type=\"number\"\n        :label=\"'Min. surplus sell price (' + market.base_currency + ')'\"\n        :suffix=\"market.base_currency\"\n        min=\"0\"\n      ></v-text-field>\n      <p class=\"subheading my-3\">Trade engine settings</p>\n\n      <v-text-field\n        v-if=\"market.enabled && user.subscription_name !== 'Herring'\"\n        v-model=\"market.aggressiveness_pct\"\n        type=\"number\"\n        label=\"Trade engine aggressiveness\"\n        append-icon=\"fa-info-circle\"\n        :rules=\"[\n          x => !!x || $t('settings.trade_engine_aggressiveness_error'),\n          x =>\n            (x >= 1 && x <= 220) ||\n            $t('settings.trade_engine_aggressiveness_error')\n        ]\"\n        prefix=\"%\"\n        min=\"1\"\n        max=\"220\"\n        required\n        @click:append=\"\n          () => {\n            infoAlert(\n              $t('settings.trade_engine_aggressiveness_title'),\n              $t('settings.trade_engine_aggressiveness_text')\n            );\n          }\n        \"\n      ></v-text-field>\n      <v-text-field\n        v-if=\"market.enabled\"\n        v-model=\"market.max_buy_price\"\n        type=\"number\"\n        label=\"Max. buy price\"\n        append-icon=\"fa-info-circle\"\n        min=\"0\"\n        :rules=\"[x => (x && x > 0) || !x || $t('settings.max_buy_price_error')]\"\n        @click:append=\"\n          () => {\n            infoAlert(\n              $t('settings.max_buy_price_title'),\n              $t('settings.max_buy_price_text')\n            );\n          }\n        \"\n      ></v-text-field>\n      <v-text-field\n        v-if=\"market.enabled && user.subscription_name !== 'Herring'\"\n        v-model=\