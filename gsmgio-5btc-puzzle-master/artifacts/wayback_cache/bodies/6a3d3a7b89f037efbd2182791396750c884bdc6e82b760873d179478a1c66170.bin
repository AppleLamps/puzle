n = null;\n\n      this.password = null;\n    },\n    assignEthAddress: async function() {\n      this.isAssigningEthAddress = true;\n      try {\n        const wallet = await axios.get(\"/api/v1/settings/assign-eth-address\");\n\n        this.user.eth_address = wallet.data;\n        this.isAssigningEthAddress = false;\n      } catch (error) {\n        swal({\n          title: error.response.data,\n          type: \"error\"\n        });\n\n        this.isAssigningEthAddress = false;\n        return false;\n      }\n    }\n  }\n};\n</script>\n\n\n\n// WEBPACK FOOTER //\n// resources/js/pages/settings/index.vue","var normalizeComponent = require(\"!../../../node_modules/vue-loader/lib/component-normalizer\")\n/* script */\nvar __vue_script__ = require(\"!!babel-loader?{\\\"cacheDirectory\\\":true,\\\"presets\\\":[[\\\"env\\\",{\\\"modules\\\":false,\\\"targets\\\":{\\\"browsers\\\":[\\\"> 2%\\\"],\\\"uglify\\\":true}}]],\\\"plugins\\\":[\\\"transform-object-rest-spread\\\",[\\\"transform-runtime\\\",{\\\"polyfill\\\":false,\\\"helpers\\\":false}]]}!../../../node_modules/vue-loader/lib/selector?type=script&index=0!./markets.vue\")\n/* template */\nvar __vue_template__ = require(\"!!../../../node_modules/vue-loader/lib/template-compiler/index?{\\\"id\\\":\\\"data-v-7be8dee6\\\",\\\"hasScoped\\\":false,\\\"buble\\\":{\\\"transforms\\\":{}}}!../../../node_modules/vue-loader/lib/selector?type=template&index=0!./markets.vue\")\n/* template functional */\nvar __vue_template_functional__ = false\n/* styles */\nvar __vue_styles__ = null\n/* scopeId */\nvar __vue_scopeId__ = null\n/* moduleIdentifier (server only) */\nvar __vue_module_identifier__ = null\nvar Component = normalizeComponent(\n  __vue_script__,\n  __vue_template__,\n  __vue_template_functional__,\n  __vue_styles__,\n  __vue_scopeId__,\n  __vue_module_identifier__\n)\n\nmodule.exports = Component.exports\n\n\n\n//////////////////\n// WEBPACK FOOTER\n// ./resources/js/pages/markets.vue\n// module id = vl1O\n// module chunks = 0","<template>\n  <v-container fluid grid-list-md :style=\"{ maxWidth: '1200px' }\">\n    <v-layout row wrap>\n      <v-flex xs12 md12 lg12>\n        <v-card height=\"100%\">\n          <v-toolbar color=\"secondary\" dark>\n            <v-toolbar-title>Chart</v-toolbar-title>\n            <v-spacer></v-spacer>\n\n            <v-flex xs8 sm4 d-flex>\n              <v-select\n                :items=\"activeMarkets\"\n                label=\"Market\"\n                @change=\"loadOpenOrders\"\n              ></v-select>\n            </v-flex>\n          </v-toolbar>\n          <v-card-text>\n            <StockChart\n              v-if=\"selectedMarket\"\n              :market=\"selectedMarket\"\n              :sell-orders=\"sellOrderLevels\"\n              :buy-orders=\"buyOrderLevels\"\n              :closed-sell-orders=\"closedSellOrders\"\n              :closed-buy-orders=\"closedBuyOrders\"\n            />\n            <div v-else>Please select a market first...</div>\n          </v-card-text>\n        </v-card>\n      </v-flex>\n    </v-layout>\n    <v-layout row class=\"wrap\">\n      <v-flex xs12 md12 lg6>\n        <v-card class=\"card--flex-toolbar\" height=\"100%\">\n          <v-toolbar card prominent color=\"secondary\" dark>\n            <v-toolbar-title>Open sell orders</v-toolbar-title>\n          </v-toolbar>\n\n          <v-divider></v-divider>\n\n          <v-card-text>\n            <v-data-table\n              :headers=\"openOrderHeaders\"\n              :items=\"openOrders || []\"\n              item-key=\"uuid\"\n              no-data-text=\"To view the current opened orders, you have to select a market.\"\n            >\n              <template slot=\"items\" slot-scope=\"props\">\n                <tr\n                  :style=\"{ cursor: 'pointer' }\"\n                  @click=\"e => (props.expanded = !props.expanded)\"\n                >\n                  <td>{{ props.item.ts_opened_utc | formatDate }}</td>\n                  <td>\n                    {{ props.item.price.toFixed(8) }}\n                    {{\n                      props.item.market_name\n                        .slice(props.item.market_name.indexOf(\":\") + 1)\n                        .split(\"-\")[0]\n                    }}\n                  </td>\n                  <td>{{ props.item.quantity.toFixed(8) }}</td>\n                  <td>{{ props.item.ts_opened_utc | formatAge }}</td>\n                  <td>{{ props.item.uuid }}</td>\n                </tr>\n              </template>\n              <template slot=\"expand\" slot-scope=\"props\">\n                <TradeDetails\n                  :sell-order=\"props.item\"\n                  :base-currency=\"props.item.base_currency\"\n                />\n              </template>\n            </v-data-table>\n          </v-card-text>\n        </v-card>\n      </v-flex>\n      <v-flex xs12 lg6 md12>\n        <v-card>\n          <v-toolbar card color=\"secondary\" dark>\n            <v-toolbar-title>\n              <v-icon>fa-line-chart</v-icon>\n              Overall statistics\n            </v-toolbar-title>\n          </v-toolbar>\n          <v-card-text>\n            <v-layout row wrap>\n              <v-flex md10 xs12>Total open sell orders:</v-flex>\n              <v-flex md2 xs12 class=\"text-xs-right\">\n                <strong>\n                  <v-chip label small>{{ stats.totalOpenSellOrders }}</v-chip>\n                </strong>\n              </v-flex>\n              <v-flex md10 xs12\n                >Number of individual acquisitions in open sell orders:\n              </v-flex>\n              <v-flex md2 xs12 class=\"text-xs-right\">\n                <strong>\n                  <v-chip label small>{{ stats.totalOpenBuyOrders }}</v-chip>\n                </strong>\n              </v-flex>\n            </v-layout>\n          </v-card-text>\n        </v-card>\n      </v-flex>\n    </v-layout>\n  </v-container>\n</template>\n\n<script>\nimport axios from \"axios\";\nimport TradeDetails from \"~/components/openorders/TradeDetails\";\nimport StockChart from \"~/components/openorders/StockChart\";\nimport _ from \"lodash\";\nimport moment from \"moment-timezone/builds/moment-timezone-with-data-10-year-range\";\n\nexport default {\n  components: {\n    TradeDetails,\n    StockChart\n  },\n\n  props: {\n    uuid: {\n      type: String,\n      default: \"\"\n    }\n  },\n\n  data: () => ({\n    stats: {\n      totalOpenSellOrders: 0\n    },\n    selectedMarket: \"\",\n    activeMarkets: [],\n    openOrders: [],\n    openBuyOrders: [],\n    closedBuyOrders: [],\n    closedSellOrders: [],\n    openOrderCount: 0,\n    openOrderHeaders: [\n      {\n        text: `Opened (${moment()\n          .tz(moment.tz.guess())\n          .format(\"z\")})`,\n        value: \"ts_opened_utc\"\n      },\n      { text: \"Price\", value: \"price\" },\n      { text: \"Quantity\", value: \"quantity\" },\n      { text: \"Age\", value: \"age\" },\n      { text: \"Order ID\", value: \"uuid\" }\n    ]\n  }),\n\n  computed: {\n    buyOrderLevels: function() {\n      let levels = [];\n      this.openBuyOrders.map(order => {\n        levels.push(order.price);\n      });\n      return levels;\n    },\n    sellOrderLevels: function() {\n      let levels = [];\n      this.openOrders.map(order => {\n        levels.push(order.price);\n      });\n      return levels;\n    },\n    closedBuyOrderLevels: function() {\n      let levels = [];\n\n      _.sortBy(this.closedBuyOrders, [\"timestamp\"]);\n\n      this.closedBuyOrders.map(order => {\n        levels.push({\n          price: order.price,\n          quantity: order.quantity,\n          timestamp: order.timestamp\n        });\n      });\n      return levels;\n    },\n    closedSellOrderLevels: function() {\n      let levels = [];\n      this.closedSellOrders.map(order => {\n        levels.push({\n          price: order.price,\n          quantity: order.quantity,\n          timestamp: order.timestamp\n        });\n      });\n      return levels;\n    }\n  },\n\n  created: async function() {\n    axios.get(\"/api/v1/openorders/activemarkets\").then(res => {\n      let activeMarkets = [];\n      res.data.map(value => {\n        activeMarkets.push({\n          text: value.slice(value.indexOf(\":\") + 1),\n          value: value\n        });\n      });\n      this.activeMarkets = activeMarkets;\n    });\n\n    axios.get(\"/api/v1/openorders/stats\").then(res => {\n      this.stats = res.data;\n    });\n  },\n\n  methods: {\n    getSellOrders: function(selectedMarket) {\n      return axios.get(\"/api/v1/openorders/sellorders/\" + selectedMarket);\n    },\n    getBuyOrders: function(selectedMarket) {\n      return axios.get(\"/api/v1/openorders/buyorders/\" + selectedMarket);\n    },\n    getClosedSellOrders: function(selectedMarket) {\n      return axios.get(\"/api/v1/openorders/closedsellorders/\" + selectedMarket);\n    },\n    getClosedBuyOrders: function(selectedMarket) {\n      return axios.get(\"/api/v1/openorders/closedbuyorders/\" + selectedMarket);\n    },\n    loadOpenOrders: async function(selectedMarket) {\n      let that = this;\n      await axios\n        .all([\n          this.getSellOrders(selectedMarket),\n          this.getBuyOrders(selectedMarket),\n          this.getClosedSellOrders(selectedMarket),\n          this.getClosedBuyOrders(selectedMarket)\n        ])\n        .then(\n          axios.spread(function(\n            sellOrders,\n            buyOrders,\n            closedSellOrders,\n            closedBuyOrders\n          ) {\n            that.openOrders = sellOrders.data;\n            that.openBuyOrders = buyOrders.data;\n            that.closedSellOrders = closedSellOrders.data;\n            that.closedBuyOrders = closedBuyOrders.data;\n            that.selectedMarket = selectedMarket;\n          })\n        );\n    }\n  }\n};\n</script>\n\n\n\n// WEBPACK FOOTER //\n// resources/js/pages/openorders.vue","<template>\n  <v-container fluid grid-list-md :style=\"{ maxWidth: '1200px' }\">\n    <v-layout row wrap class=\"mb-3\">\n      <AccountInfo></AccountInfo>\n\n      <v-flex xs12 lg6 md6>\n        <TradeEngineStatus></TradeEngineStatus>\n      </v-flex>\n\n      <v-flex xs12 lg6 md6>\n        <AccountValue :account-values=\"accountValues\"></AccountValue>\n      </v-flex>\n\n      <v-flex xs12 md6 lg6>\n        <AccountValueChartWrapper\n          title=\"Total account value\"\n          :btc=\"accountValueHistory.BTC\"\n          :usd=\"accountValueHistory.USD\"\n        ></AccountValueChartWrapper>\n      </v-flex>\n\n      <v-flex xs12 md6 lg6>\n        <GraphProfitTradeWrapper></GraphProfitTradeWrapper>\n      </v-flex>\n    </v-layout>\n\n    <div v-if=\"Object.keys(this.managedValueHistory).length > 0\">\n      <h2 class=\"mt-4 title mb-2\">\n        Fractional account values for markets with same base currency\n        <v-icon\n          @click=\"\n            infoAlert(\n              $t('dashboard.fractional_account_value_title'),\n              $t('dashboard.fractional_account_value_text')\n            )\n          \"\n          >fa-info-circle</v-icon\n        >\n      </h2>\n      <v-layout row wrap class=\"mb-3\">\n        <v-flex\n          xs12\n          md6\n          lg6\n          v-for=\"(exchangeData, coin) of managedValueHistory\"\n          v-bind:key=\"coin\"\n        >\n          <ChartWrapper\n            :title=\"coin\"\n            :subtitle=\"true\"\n            :data=\"exchangeData\"\n            :coin=\"coin\"\n          ></ChartWrapper>\n        </v-flex>\n      </v-layout>\n    </div>\n\n    <h2 class=\"title mt-4 mb-2\">Profits</h2>\n\n    <v-layout>\n      <v-flex>\n        <BaseCurrencies></BaseCurrencies>\n      </v-flex>\n    </v-layout>\n\n    <v-dialog v-model=\"shareDialogOpen\" lazy max-width=\"750px\" scrollable>\n      <share :metric=\"shareMetric\" @close-dialog=\"shareDialogOpen = false\" />\n    </v-dialog>\n\n    <v-layout align-center justify-center row fill-height wrap>\n      <v-flex xs6>\n        <h2 class=\"title mt-4 mb-2\">Trade history</h2>\n      </v-flex>\n      <v-flex v-if=\"user\" xs6 class=\"text-xs-right mt-4\"\n        >Completed trade pairs today:\n        <v-btn color=\"secondary\" round @click=\"shareTotalTrades\">\n          {{ this.profitableTradesToday }}\n          <v-icon right small>fas fa-share-alt</v-icon>\n        </v-btn>\n      </v-flex>\n    </v-layout>\n\n    <v-layout>\n      <v-flex xs12>\n        <v-card>\n          <v-card-text>\n            <v-data-table\n              :headers=\"tradeValueHistoryHeaders\"\n              :items=\"tradeValueTrades\"\n              :disable-initial-sort=\"true\"\n              item-key=\"sell_order_uuid_hash\"\n            >\n              <template slot=\"items\" slot-scope=\"props\">\n                <tr\n                  :style=\"{ cursor: 'pointer' }\"\n                  @click=\"e => (props.expanded = !props.expanded)\"\n                >\n                  <td>{{ props.item.ts_closed_utc | formatDate }}</td>\n                  <td>\n                    {{ props.item.base_currency }} -\n                    {{ props.item.target_currency }}\n                  </td>\n                  <td>\n                    {{\n                      props.item.quantity\n                        ? props.item.quantity.toString().substring(0, 9)\n                        : 0\n                    }}\n                  </td>\n                  <td>\n                    {{\n                      props.item.surplus_quantity_total\n                        ? props.item.surplus_quantity_total\n                            .toString()\n                            .substring(0, 9)\n                        : 0\n                    }}\n                  </td>\n                  <td\n                    v-if=\"\n                      props.item.quantity !== props.item.surplus_quantity_total\n                    \"\n                  >\n                    <v-btn small flat @click.stop=\"shareSingleTrade(props.item.uuid)\">\n                      {{ props.item.base_currency }}\n                      {{ props.item.profit.toFixed(8) }} ({{\n                        props.item.profit_percentage.toFixed(2)\n                      }}%)\n                      <v-icon right small>fas fa-share-alt</v-icon>\n                    </v-btn>\n                  </td>\n                  <td v-else>{{ $t(\"not_applicable\") }}</td>\n                  <td>\n                    {{ props.item.base_currency }}\n                    {{ props.item.total_commission_paid.toFixed(8) }}\n                  </td>\n                  <td\n                    v-if=\"\n                      props.item.quantity !== props.item.surplus_quantity_total\n                    \"\n                  >\n                    ETH\n                    <span :title=\"props.item.gsmg_fee_gwei + ' GWEI'\">{{\n                      props.item.gsmg_fee_gwei / 1e9\n                    }}</span>\n                  </td>\n                  <td v-else>{{ $t(\"not_applicable\") }}</td>\n                </tr>\n              </template>\n              <template slot=\"expand\" slot-scope=\"props\">\n                <TradeDetails\n                  :sell-order=\"props.item\"\n                  :base-currency=\"props.item.base_currency\"\n                />\n              </template>\n            </v-data-table>\n          </v-card-text>\n        </v-card>\n      </v-flex>\n    </v-layout>\n\n    <v-layout>\n      <h2 class=\"title mt-4 mb-2\">\n        Accumulated funds (buy history)\n        <v-icon\n          class=\"vertical-align-middle\"\n          @click=\"\n            () => {\n              infoAlert(\n                $t('market_actions.release_funds_title'),\n                $t('market_actions.release_funds_text')\n              );\n            }\n          \"\n          >fa-info-circle</v-icon\n        >\n        <v-btn\n          v-if=\"markets\"\n          round\n          @click.stop=\"addManualBuyOrderDialogOpened = true\"\n        >\n          Manually add historic buy order\n          <v-icon class=\"vertical-align-middle\" right>fa fa-plus</v-icon></v-btn\n        >\n      </h2>\n      <v-dialog v-model=\"addManualBuyOrderDialogOpened\" lazy max-width=\"70%\">\n        <AddManualBuyOrderAccumulatedFunds\n          v-on:close-dialog=\"closeDialogForManualBuy\"\n        ></AddManualBuyOrderAccumulatedFunds>\n      </v-dialog>\n    </v-layout>\n\n    <v-layout>\n      <v-flex>\n        <MarketActions></MarketActions>\n      </v-flex>\n    </v-layout>\n  </v-container>\n</template>\n\n<style scoped>\n.vertical-align-middle {\n  vertical-align: middle;\n}\n</style>\n\n<script>\nimport { mapGetters } from \"vuex\";\nimport AccountInfo from \"~/components/dashboard/AccountInfo\";\nimport ChartWrapper from \"~/components/dashboard/ChartWrapper\";\nimport AccountValueChartWrapper from \"~/components/dashboard/AccountValueChartWrapper\";\nimport GraphProfitTradeWrapper from \"~/components/dashboard/GraphProfitTradeWrapper\";\nimport AccountValue from \"~/components/dashboard/AccountValue\";\nimport BaseCurrencies from \"~/components/dashboard/BaseCurrencies\";\nimport TradeDetails from \"~/components/dashboard/TradeDetails\";\nimport MarketActions from \"~/components/dashboard/MarketActions\";\nimport TradeEngineStatus from \"~/components/dashboard/TradeEngineStatus\";\nimport swal from \"sweetalert2\";\nimport axios from \"axios\";\nimport moment from \"moment-timezone/builds/moment-timezone-with-data-10-year-range\";\nimport AddManualBuyOrderAccumulatedFunds from \"../components/dashboard/AddManualBuyOrderAccumulatedFunds\";\nimport Share from \"../components/dashboard/Share\";\n\nexport default {\n  metaInfo() {\n    return { title: this.$t(\"page-dashboard\") };\n  },\n  components: {\n    Share,\n    AddManualBuyOrderAccumulatedFunds,\n    AccountInfo,\n    ChartWrapper,\n    GraphProfitTradeWrapper,\n    AccountValue,\n    BaseCurrencies,\n    TradeDetails,\n    MarketActions,\n    TradeEngineStatus,\n    AccountValueChartWrapper\n  },\n  data: function() {\n    return {\n      shareDialogOpen: false,\n      tradeValueTrades: [],\n      addManualBuyOrderDialogOpened: false,\n      shareMetric: null,\n      tradeValueHistoryHeaders: [\n        {\n          text: `Date time (${moment()\n            .tz(moment.tz.guess())\n            .format(\"z\")})`,\n          value: \"ts_utc_string\"\n        },\n        { text: \"Trade pair\", value: \"trade_pair\" },\n        { text: \"Quantity\", value: \"quantity\" },\n        { text: \"Surplus qty\", value: \"surplus_quantity\" },\n        { text: \"Profit\", value: \"profit\" },\n        { text: \"Exchange commission\", value: \"total_commission_paid\" },\n        { text: \"GSMG commission\", value: \"gsmg_fee_gwei\" }\n      ]\n    };\n  },\n  computed: {\n    ...mapGetters({\n      user: \"auth/user\",\n      profitTradeHistoryData: \"accountValue/profit_trades_last_week\",\n      accountValues: \"accountValue/values\",\n      managedValueHistory: \"accountValue/managed_value_history\",\n      accountValueHistory: \"accountValue/account_value_history\",\n      markets: \"markets/markets\"\n    }),\n    profitableTradesToday: function() {\n      let ts = moment()\n        .tz(moment.tz.guess())\n        .format(\"YYYY-MM-DD\");\n\n      if (!this.profitTradeHistoryData[ts]) {\n        return 0;\n      }\n\n      return this.profitTradeHistoryData[ts];\n    }\n  },\n  created: async function() {\n    await axios.get(\"/api/v1/trade/closed\").then(res => {\n      this.tradeValueTrades = res.data;\n    });\n\n    await this.$store.dispatch(\"accountValue/fetchAll\");\n  },\n  methods: {\n    shareTotalTrades() {\n      this.shareMetric = \"trades-per-day\";\n      this.shareDialogOpen = true;\n    },\n    shareSingleTrade(tradeId) {\n      this.shareMetric = tradeId;\n      this.shareDialogOpen = true;\n    },\n    infoAlert: async function(title, text) {\n      await swal({\n        title: