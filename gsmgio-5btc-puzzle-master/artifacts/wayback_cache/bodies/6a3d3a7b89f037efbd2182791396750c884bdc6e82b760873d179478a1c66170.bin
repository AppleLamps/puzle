      <v-list-tile-content class=\"text-xs-center\">\n                  <v-flex style=\"width: 100%\">30 day fee in USD</v-flex>\n                </v-list-tile-content>\n              </v-list-tile>\n            </v-list>\n          </v-card>\n        </v-flex>\n        <v-flex\n          v-for=\"subscription in subscriptions\"\n          :key=\"subscription.name\"\n          xs12\n          md2\n          lg2\n        >\n          <v-card>\n            <v-flex>\n              <v-list>\n                <v-list-tile>\n                  <v-list-tile-title>\n                    <v-flex class=\"title text-xs-center font-weight-black\">{{\n                      subscription.name\n                    }}</v-flex>\n                  </v-list-tile-title>\n                </v-list-tile>\n                <v-list-tile>\n                  <v-list-tile-content class=\"text-xs-center\">\n                    <v-flex style=\"width: 100%\">\n                      <v-icon color=\"success\">check_circle</v-icon>\n                    </v-flex>\n                  </v-list-tile-content>\n                </v-list-tile>\n                <v-list-tile avatar>\n                  <v-list-tile-content class=\"text-xs-center\">\n                    <v-flex style=\"width: 100%\">\n                      <div v-if=\"subscription.name !== 'Herring'\">\n                        <v-icon color=\"success\">check_circle</v-icon>\n                      </div>\n                      <div v-else>Only max buy price</div>\n                    </v-flex>\n                  </v-list-tile-content>\n                </v-list-tile>\n                <v-list-tile>\n                  <v-list-tile-content class=\"text-xs-center\">\n                    <v-flex style=\"width: 100%\">\n                      <div\n                        v-if=\"subscription.max_account_value_per_exchange_btc\"\n                      >\n                        {{ subscription.max_account_value_per_exchange_btc }}\n                        BTC\n