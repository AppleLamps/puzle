 ></v-slider>\n          </td>\n          <td>\n            <v-text-field\n              type=\"number\"\n              min=\"0\"\n              max=\"100\"\n              v-model=\"props.item.allocation\"\n              label=\"percentage\"\n              @change=\"saveAllocation($event, props.item)\"\n            ></v-text-field>\n          </td>\n        </template>\n      </v-data-table>\n    </v-flex>\n  </v-layout>\n</template>\n\n<script>\nimport { mapGetters } from \"vuex\";\nimport axios from \"axios\";\nimport _ from \"lodash\";\nimport swal from \"sweetalert2\";\nimport { bugsnagClient } from \"~/plugins\";\n\nexport default {\n  props: {\n    baseCurrency: String,\n    markets: Array\n  },\n  data: function() {\n    return {\n      tableHeaders: [\n        {\n          title: \"Name\"\n        },\n        {\n          title: \"Allocation\"\n        }\n      ]\n    };\n  },\n  computed: {\n    allocationLeft: function() {\n      let result = {};\n\n      // 100 - allocation\n      Object.keys(this.totalAllocations).map((key, index) => {\n        result[key] = 100 - this.totalAllocations[key];\n      });\n\n      return result;\n    },\n    ...mapGetters({\n      totalAllocations: \"markets/totalAllocations\"\n    })\n  },\n  methods: {\n    saveAllocation: _.debounce(async function(event, market) {\n      let targetAllocation = market.allocation;\n\n      if (isNaN(targetAllocation)) {\n        targetAllocation = 0;\n      }\n\n      if (this.totalAllocations[market.base_currency] > 100) {\n        targetAllocation -= this.totalAllocations[market.base_currency] - 100;\n      }\n\n      this.$store.dispatch(\"markets/updateMarketAllocation\", {\n        baseCurrency: market.base_currency,\n        marketName: market.name,\n        pct: targetAllocation\n      });\n\n      try {\n        await axios.put(\n          \"/api/v1/markets/\" + market.name + \"/percent/\" + targetAllocation\n        );\n      } catch (error) {\n        await swal({\n          title: \"Problem saving allocation\",\n          type: \"error\"\n        });\n\n        bugsnagClient.notify(error);\n      }\n    }, 400)\n  }\n};\n</script>\n\n\n\n// WEBPACK FOOTER //\n// resources/js/components/dashboard/MarketAllocations.vue","<template>\n  <div class=\"text-xs-center\">\n    <highcharts\n      v-if=\"dataLoaded\"\n      ref=\"wrapper\"\n      class=\"stock\"\n      :constructor-type=\"'stockChart'\"\n      :options=\"stockOptions\"\n    ></highcharts>\n    <div v-else>\n      <v-progress-circular\n        :size=\"50\"\n        color=\"primary\"\n        indeterminate\n      ></v-progress-circular>\n      <h2>{{ status }}</h2>\n    </div>\n  </div>\n</template>\n\n<script>\nimport axios from \"axios\";\nimport { mapGetters } from \"vuex\";\nimport moment from \"moment-timezone/builds/moment-timezone-with-data-10-year-range\";\n\nexport default {\n  props: {\n    market: null,\n    sellOrders: null,\n    buyOrders: null,\n    closedSellOrders: null,\n    closedBuyOrders: null\n  },\n  data: function() {\n    const intialDarkMode = window.localStorage.getItem(\"nightmode\") === \"true\";\n    const vm = this;\n    const timezone = moment()\n      .tz(moment.tz.guess())\n      .format(\"z\");\n\n    return {\n      lastMin: 1, // instead of 0, prevents devision by 0 errors.\n      lastMax: 1,\n      dataLoaded: false,\n      enriched: false,\n      status: \"Loading candlesticks...\",\n      stockOptions: {\n        yAxis: {\n          floor: 0,\n          plotLines: [],\n          scrollbar: {\n            enabled: true,\n            showFull: false\n          }\n        },\n\n        tooltip: {\n          headerFormat: `{point.x:%Y-%m-%d %H:%M:%S} ${timezone}`\n        },\n\n        xAxis: {\n          events: {\n            afterSetExtremes: _.debounce(this.enrichData, 250)\n          },\n          minRange: 3600 * 1000,\n          title: {\n            text: timezone,\n            style: {\n              color: this.darkmode ? \"white\" : \"#333\"\n            }\n          }\n        },\n\n        navigator: {\n          series: {\n            color: \"#333\",\n            lineWidth: 2\n          },\n          adaptToUpdatedData: false\n        },\n\n        scrollbar: {\n          liveRedraw: false\n        },\n\n        rangeSelector: {\n          buttons: [\n            {\n              type: \"hour\",\n              count: 1,\n              text: \"1h\"\n            },\n            {\n              type: \"day\",\n              count: 1,\n              text: \"1d\"\n            },\n            {\n              type: \"week\",\n              count: 1,\n              text: \"1w\"\n            },\n            {\n              type: \"all\",\n              count: 1,\n              text: \"All\"\n            }\n          ],\n          selected: 1,\n          inputEnabled: false\n        },\n\n        plotOptions: {\n          candlestick: {\n            color: this.$vuetify.theme.error,\n            upColor: this.$vuetify.theme.success\n          },\n          series: {\n            turboThreshold: 1500\n          }\n        },\n\n        chart: {\n          zoomType: \"xy\",\n          backgroundColor: intialDarkMode ? \"#424242\" : \"#fff\",\n          height: \"500px\",\n          marginRight: 67,\n          events: {\n            load: function(e) {\n              if (!vm.enriched) {\n                // vm.$refs.wrapper.chart.redraw();\n                e.target.redraw();\n              }\n            }\n          }\n        },\n\n        loading: {\n          style: {\n            position: \"absolute\",\n            backgroundColor: intialDarkMode ? \"#424242\" : \"#ffffff\",\n            opacity: 0.5,\n            textAlign: \"center\",\n            color: intialDarkMode ? \"#fff\" : \"#333333\"\n          }\n        },\n\n        title: {\n          style: {\n            color: intialDarkMode ? \"#ffffff\" : \"#333333\",\n            fontsize: \"16px\"\n          }\n        },\n\n        series: [\n          {\n            name: \"\",\n            type: \"candlestick\",\n            id: \"candlestick\",\n            data: [],\n            tooltip: {\n              valueDecimals: 8\n            },\n            dataGrouping: {\n              enabled: true,\n              groupPixelWidth: 8\n            }\n          },\n          {\n            type: \"scatter\",\n            data: [],\n            color: \"orange\",\n            tooltip: {\n              headerFormat: \"\",\n              pointFormat: `Sold {point.quantity} at {point.y} on {point.x:%Y-%m-%d %H:%M:%S} ${timezone}`\n            },\n            marker: {\n              symbol: \"triangle-down\",\n              radius: 3\n            }\n          },\n          {\n            type: \"scatter\",\n            data: [],\n            color: \"#00ff00\",\n            tooltip: {\n              headerFormat: \"\",\n              pointFormat: `Bought {point.quantity} at {point.y} on {point.x:%Y-%m-%d %H:%M:%S} ${timezone}`\n            },\n            marker: {\n              symbol: \"triangle\",\n              radius: 3\n            }\n          }\n        ]\n      }\n    };\n  },\n\n  computed: {\n    ...mapGetters({\n      darkmode: \"settings/darkmode\"\n    })\n  },\n\n  watch: {\n    market: function() {\n      this.loadData();\n    },\n    darkmode: function(darkMode) {\n      this.stockOptions.chart.backgroundColor = darkMode ? \"#424242\" : \"#fff\";\n      this.stockOptions.title.color = darkMode ? \"#ffffff\" : \"#333333\";\n\n      this.stockOptions.loading.style.backgroundColor = darkMode\n        ? \"#424242\"\n        : \"#fff\";\n      this.stockOptions.loading.style.color = darkMode ? \"#fff\" : \"#333333\";\n\n      this.$refs.wrapper.chart.redraw();\n    }\n  },\n\n  created: function() {\n    this.loadData();\n  },\n\n  methods: {\n    enrichData: async function(e) {\n      let min = Math.round(e.min);\n      let max = Math.round(e.max);\n\n      if (isNaN(min) || isNaN(max)) {\n        return;\n      }\n\n      if (\n        Math.abs(min / this.lastMin - 1) <= 0.002 &&\n        Math.abs(max / this.lastMax - 1) <= 0.002\n      ) {\n        // chart isn't reloaded because the difference is less than 0.2%\n        return;\n      }\n\n      this.lastMin = min;\n      this.lastMax = max;\n\n      this.$refs.wrapper.chart.showLoading(this.status);\n      const url = `/api/v1/chart/candles/${this.market}/${min}/${max}/1`;\n      await axios.get(url).then(res => {\n        const data = this.mergeEnrichedData(\n          this.stockOptions.series[0].data,\n          res.data\n        );\n\n        this.$refs.wrapper.chart.hideLoading();\n        this.$refs.wrapper.chart.series[0].setData(data);\n\n        this.enriched = true;\n      });\n    },\n    mergeEnrichedData: function(currentData, newData) {\n      let merged = [...currentData, ...newData];\n      let structured = {};\n      for (let item of merged) {\n        structured[item[0]] = item;\n      }\n\n      return Object.values(structured).sort((a, b) => {\n        if (a[0] === b[0]) {\n          return 0;\n        }\n\n        return a[0] < b[0] ? -1 : 1;\n      });\n    },\n    loadData: async function(e) {\n      try {\n        this.dataLoaded = false;\n        this.enriched = false;\n        this.lastMin = 1;\n        this.lastMax = 1;\n\n        await axios.get(`/api/v1/chart/candles/${this.market}`).then(res => {\n          this.stockOptions.series[0].data = res.data;\n          this.stockOptions.navigator.data = res.data;\n          this.stockOptions.title.text = this.market;\n        });\n\n        this.stockOptions.yAxis.plotLines = [];\n        this.sellOrders &&\n          (await this.sellOrders.map(sellPrice => {\n            this.stockOptions.yAxis.plotLines.push({\n              value: sellPrice,\n              label: {\n                text: sellPrice.toFixed(8).substring(0, 9),\n                align: \"right\",\n                x: 65,\n                y: 4,\n                style: {\n                  color: \"white\",\n                  backgroundColor: this.$vuetify.theme.error,\n                  fontWeight: \"bold\"\n                },\n                useHTML: true\n              },\n              color: this.$vuetify.theme.error,\n              dashStyle: \"solid\",\n              width: 0.5\n            });\n          }));\n\n        this.buyOrders &&\n          (await this.buyOrders.map(buyPrice => {\n            this.stockOptions.yAxis.plotLines.push({\n              value: buyPrice,\n              label: {\n                text: buyPrice.toFixed(8).substring(0, 9),\n                align: \"right\",\n                x: 65,\n                y: 4,\n                style: {\n                  color: \"white\",\n                  backgroundColor: this.$vuetify.theme.success,\n                  fontWeight: \"bold\"\n                },\n                useHTML: true\n              },\n              color: this.$vuetify.theme.success,\n              dashStyle: \"solid\",\n              width: 0.5\n            });\n          }));\n\n        this.stockOptions.series[1].data = [];\n        this.closedSellOrders &&\n          (await this.closedSellOrders.map(order => {\n            this.stockOptions.series[1].data.push({\n              x: order.timestamp,\n              y: order.price,\n              quantity: order.quantity\n            });\n          }));\n\n        this.stockOptions.series[2].data = [];\n        this.closedBuyOrders &&\n          (await this.closedBuyOrders.map(order => {\n            this.stockOptions.series[2].data.push({\n              x: order.timestamp,\n              y: order.price,\n              quantity: order.quantity\n            });\n          }));\n\n        this.dataLoaded = true;\n      } catch (e) {\n        console.log(e);\n      }\n    }\n  }\n};\n</script>\n<style scoped>\n.stock {\n  width: 100%;\n  margin: 0 auto;\n}\n</style>\n\n\n\n// WEBPACK FOOTER //\n// resources/js/components/openorders/StockChart.vu