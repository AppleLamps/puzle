content, .swal2-title {\n    text-align: left;\n  }\n\n  .swal2-header {\n    align-items: stretch;\n  }\n}\n//******************** SWAL COMMON END ********************************//\n//************************ SWAL LOGIN/REGISTER START ****************************//\n.swal-login-register.swal2-popup {\n  border-radius: 10px !important;\n  padding: 0px !important;\n}\n.swal-login-register.swal2-popup {\n  .swal2-close {\n    margin-top: 24px;\n    margin-right: 24px;\n  }\n  .swal2-image {\n    margin-top: 48px;\n    margin-bottom: 32px !important;\n  }\n  .swal2-title {\n    font-family: \"Lato\", serif !important;\n    text-align: center;\n    display: inline !important;\n    font-style: normal;\n    font-weight: bold;\n    font-size: 28px;\n    line-height: 34px;\n    color: #103A84;\n    margin-bottom: 16px !important;\n  }\n  .swal2-content {\n    text-align: center;\n    font-family: \"Lato\", serif !important;\n    font-style: normal;\n    font-weight: normal;\n    font-size: 18px;\n    line-height: 140%;\n    color: #7395D0;\n  }\n  .swal2-content a {\n    color: #639BFB;\n  }\n  #swal2-content {\n    text-align: center;\n  }\n  .swal2-close {\n    color: #959596;\n    border-radius: 85px;\n  }\n  .swal2-close:hover {\n    color: #536580;\n    background: #F3F4F6;\n    border-radius: 85px;\n  }\n  .swal2-actions {\n    .swal2-confirm {\n      margin-top: 40px;\n      margin-bottom: 64px;\n      background: #7EC171;\n      border-radius: 70px;\n      width: 207px;\n      font-family: \"Lato\", serif !important;\n      font-style: normal;\n      font-weight: bold;\n      font-size: 18px;\n      line-height: 22px;\n      text-align: center;\n      color: #FFFFFF;\n    }\n  }\n}\n//************************ SWAL LOGIN/REGISTER END ****************************//\n//************************ SWAL LOGIN/REGISTER/DISCLAIMER START ****************************//\n.swal-login-register-disclaimer.swal2-popup {\n  border-radius: 10px !important;\n  padding: 0px !important;\n  width: 560px;\n}\n.swal-login-register-disclaimer.swal2-popup {\n  .swal2-close {\n    margin-top: 24px;\n    margin-right: 24px;\n  }\n  .swal2-image {\n    margin-top: 48px;\n    margin-bottom: 32px !important;\n    margin-left: 48px;\n  }\n  .swal2-title {\n    font-family: \"Lato\", serif !important;\n    text-align: left;\n    display: inline !important;\n    font-style: normal;\n    font-weight: bold;\n    font-size: 28px;\n    line-height: 34px;\n    color: #103A84;\n    margin-bottom: 16px !important;\n    margin-left: 48px;\n  }\n  .swal2-content {\n    text-align: left;\n    font-family: \"Lato\", serif !important;\n    font-style: normal;\n    font-weight: normal;\n    font-size: 18px;\n    line-height: 140%;\n    color: #7395D0;\n  }\n  .swal2-content a {\n    color: #639BFB;\n  }\n  #swal2-content {\n    text-align: left;\n    margin-right: 48px;\n    margin-left: 48px;\n  }\n  .swal2-actions {\n    justify-content: left;\n    margin-left: 48px;\n    margin-top: 0px;\n  }\n  .swal2-close {\n    color: #959596;\n    border-radius: 85px;\n  }\n  .swal2-close:hover {\n    color: #536580;\n    background: #F3F4F6;\n    border-radius: 85px;\n  }\n  .swal2-actions {\n    .swal2-confirm {\n      margin-top: 32px;\n      margin-bottom: 64px;\n      background: #7EC171;\n      border-radius: 70px;\n      width: 180px;\n      font-family: \"Lato\", serif !important;\n      font-style: normal;\n      font-weight: bold;\n      font-size: 18px;\n      line-height: 22px;\n      text-align: center;\n      color: #FFFFFF;\n    }\n    .swal2-cancel {\n      background: #E6EFFF;\n      border-radius: 40px;\n      margin-top: 32px;\n      margin-bottom: 64px;\n      width: 180px;\n      font-family: \"Lato\", serif !important;\n      font-style: normal;\n      font-weight: normal;\n      font-size: 18px;\n      line-height: 22px;\n      text-align: center;\n      color: #103A84;\n    }\n  }\n}\n//************************ SWAL LOGIN/REGISTER/DISCLAIMER END ****************************//\n\n//************************ SWAL SUCCESS START ****************************//\n.swal-type-success.swal2-popup {\n  border-radius: 10px !important;\n  padding: 0px !important;\n}\n.swal-type-success.swal2-popup {\n  .swal2-close {\n    margin-top: 24px;\n    margin-right: 24px;\n  }\n  .swal2-image {\n    margin-top: 48px;\n    margin-bottom: 32px !important;\n  }\n  .swal2-title {\n    font-family: \"Lato\", serif !important;\n    text-align: center;\n    display: inline !important;\n    font-style: normal;\n    font-weight: bold;\n    font-size: 28px;\n    line-height: 34px;\n    color: #103A84;\n    margin-bottom: 16px !important;\n  }\n  .swal2-content {\n    text-align: center;\n    font-family: \"Lato\", serif !important;\n    font-style: normal;\n    font-weight: normal;\n    font-size: 18px;\n    line-height: 140%;\n    color: #7395D0;\n  }\n  #swal2-content {\n    text-align: center;\n  }\n  .swal2-close {\n    color: #959596;\n    border-radius: 85px;\n  }\n  .swal2-close:hover {\n    color: #536580;\n    background: #F3F4F6;\n    border-radius: 85px;\n  }\n  .swal2-actions {\n    .swal2-confirm {\n      margin-top: 40px;\n      margin-bottom: 64px;\n      background: #7EC171;\n      border-radius: 70px;\n      width: 207px;\n      font-family: \"Lato\", serif !important;\n      font-style: normal;\n      font-weight: bold;\n      font-size: 18px;\n      line-height: 22px;\n      text-align: center;\n      color: #FFFFFF;\n    }\n  }\n}\n\n.swal-type-success-dark.swal2-popup {\n  border-radius: 10px !important;\n  padding: 0px !important;\n  background: #303030;\n}\n.swal-type-success-dark.swal2-popup {\n  .swal2-close {\n    margin-top: 24px;\n    margin-right: 24px;\n  }\n  .swal2-image {\n    margin-top: 48px;\n    margin-bottom: 32px !important;\n  }\n  .swal2-title {\n    font-family: \"Lato\", serif !important;\n    text-align: center;\n    display: inline !important;\n    font-style: normal;\n    font-weight: bold;\n    font-size