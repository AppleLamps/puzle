     :headers=\"buyOrderHeaders\"\n        :items=\"buyOrders || []\"\n        :disable-initial-sort=\"true\"\n        :item-key=\"uuid\"\n        hide-actions\n      >\n        <template slot=\"items\" slot-scope=\"props\">\n          <td>{{ props.item.ts_opened_utc | formatDate }}</td>\n          <td>{{ props.item.ts_closed_utc | formatDate }}</td>\n          <td>{{ props.item.price.toFixed(8) }}</td>\n          <td>{{ props.item.quantity.toFixed(8) }}</td>\n          <td>\n            {{ baseCurrency }} {{ props.item.commission_paid.toFixed(8) }}\n          </td>\n          <td>{{ props.item.uuid }}</td>\n        </template>\n      </v-data-table>\n    </v-card-text>\n  </v-card>\n</template>\n\n<script>\nimport axios from \"axios\";\nimport moment from \"moment-timezone/builds/moment-timezone-with-data-10-year-range\";\n\nconst timezone = moment()\n  .tz(moment.tz.guess())\n  .format(\"z\");\n\nexport default {\n  props: {\n    baseCurrency: null,\n    sellOrder: {},\n    uuid: null\n  },\n  data: function() {\n    return {\n      buyOrders: [],\n      buyOrderHeaders: [\n        { text: `Opened (${timezone})`, value: \"ts_opened_utc\" },\n        { text: `Closed (${timezone})`, value: \"ts_closed_utc\" },\n        { text: \"Price\", value: \"price\" },\n        { text: \"Quantity\", value: \"quantity\" },\n        { text: \"Commission paid\", value: \"commission_paid\" },\n        { text: \"Order ID\", value: \"uuid\" }\n      ]\n    };\n  },\n  created: async function() {\n    axios.get(\"/api/v1/trade/details/\" + this.sellOrder.uuid).then(res => {\n      this.buyOrders = res.data;\n    });\n  }\n};\n</script>\n\n\n\n// WEBPACK FOOTER //\n// resources/js/components/dashboard/TradeDetails.vue","// style-loader: Adds some css to the DOM by adding a <style> tag\n\n// load the styles\nvar content = require(\"!!../../../../node_modules/css-loader/index.js?minimize!../../../../node_modules/vue-loader/lib/style-compiler/index.js?{\\\"vue\\\":true,\\\"id\\\":\\\"data