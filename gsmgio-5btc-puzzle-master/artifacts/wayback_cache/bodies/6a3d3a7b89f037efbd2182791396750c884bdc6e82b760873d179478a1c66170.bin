\n      <span class=\"ml-3\">\n        <v-icon color=\"#2f9997\" small>fas fa-circle</v-icon>\n        in open buy orders\n      </span>\n    </p>\n\n    <v-data-table\n      :headers=\"tableHeaders\"\n      disable-initial-sort\n      :custom-sort=\"sortMarketsOnEnabled\"\n      :items=\"\n        markets.filter(\n          market =>\n            market.enabled ||\n            (market.hasOwnProperty('has_allocations') &&\n              market.has_allocations === true)\n        )\n      \"\n      item-key=\"name\"\n      :rows-per-page-items=\"[10, 25, 50, { text: 'All', value: -1 }]\"\n    >\n      <template slot=\"items\" slot-scope=\"props\">\n        <tr :class=\"props.item.enabled ? 'enabled' : 'disabled'\">\n          <td>\n            <div class=\"subheading mt-4\">\n              <span v-if=\"props.item.enabled\">\n                {{ props.item.market_name }}\n              </span>\n              <span v-else class=\"text--disabled\">\n                {{ props.item.market_name }}\n              </span>\n            </div>\n            <v-slider\n              v-model=\"props.item.allocation\"\n              min=\"0\"\n              max=\"100\"\n              class=\"child-slider mt-0\"\n              @input=\"saveAllocation($event, props.item)\"\n              :style=\"{\n                '--allocation-green-pct': `${getSellPct(\n                  props.item.exchange,\n                  props.item.name\n                ) + getBuyPct(props.item.exchange, props.item.name)}%`,\n                '--allocation-red-pct': `${getSellPct(\n                  props.item.exchange,\n                  props.item.name\n                )}%`\n              }\"\n            ></v-slider>\n          </td>\n          <td v-if=\"props.item.enabled\">\n            <v-text-field\n              v-model=\"props.item.allocation\"\n              type=\"number\"\n              min=\"0\"\n              max=\"100\"\n              label=\"percentage\"\n              @change=\"saveAllocation($event, props.item)\"\n            ></v-text-field>\n          </td>\n          <td v-else>\n            <v-text-field\n              :value=\"\n                getSellPct(props.item.exchange, props.item.name)\n                  | roundNumber(2)\n              \"\n              type=\"number\"\n              label=\"percentage\"\n              disabled\n            ></v-text-field>\n          </td>\n          <td v-if=\"props.item.enabled\">\n            <v-btn\n              icon\n              flat\n              primary\n              @click=\"\n                e => props.item.enabled && (props.expanded = !props.expanded)\n              \"\n            >\n              <v-icon>fas fa-sliders-h</v-icon>\n            </v-btn>\n            <v-btn icon flat small @click=\"disableMarket(props.item)\">\n              <v-icon>fas fa-times</v-icon>\n            </v-btn>\n          </td>\n          <td v-else>\n            <v-btn\n              v-if=\"props.item.is_active == 1\"\n              flat\n              small\n              icon\n              @click=\"enableMarket(props.item)\"\n            >\n              <v-icon>fas fa-check</v-icon>\n            </v-btn>\n          </td>\n        </tr>\n      </template>\n      <template v-if=\"props.item.enabled\" slot=\"expand\" slot-scope=\"props\">\n        <ActiveMarketsItemAdvanced\n          :market=\"props.item\"\n        ></ActiveMarketsItemAdvanced>\n      </template>\n    </v-data-table>\n  </div>\n</template>\n\n<style scoped>\n.child-slider >>> .v-slider .v-slider__track__container,\n.master-slider >>> .v-slider .v-slider__track__container {\n  /*noinspection CssUnresolvedCustomProperty*/\n  background: linear-gradient(\n    to right,\n    #db4a36 0%,\n    #db4a36 var(--allocation-red-pct, 0%),\n    #2f9997 var(--allocation-red-pct, 0%),\n    #2f9997 var(--allocation-green-pct, 0%),\n    #ffffff var(--allocation-green-pct, 0%),\n    #ffffff 100%\n  );\n  border: 1px solid #424242;\n  height: 10px;\n}\n\n@media all and (-ms-high-contrast: none), (-ms-high-contrast: active) {\n  .child-slider >>> .v-slider .v-slider__track__container,\n  .master-slider >>> .v-slider .v-slider__track__container {\n    background: #ffffff;\n  }\n}\n\n.child-slider >>> .v-slider .v-slider__track__container .v-slider__track,\n.master-slider >>> .v-slider .v-slider__track__container .v-slider__track {\n  background: none !important;\n}\n\n.child-slider >>> .v-slider .v-slider__track__container .v-slider__track-fill,\n.master-slider >>> .v-slider .v-slider__track__container .v-slider__track-fill {\n  background: none !important;\n}\n\n.child-slider >>> .v-slider .v-slider__thumb-container .v-slider__thumb,\n.master-slider >>> .v-slider .v-slider__thumb-container .v-slider__thumb {\n  width: 10px !important;\n  left: -5px !important;\n  height: 40px !important;\n  border-radius: 0 !important;\n  background-color: #2b4889 !important;\n  border-color: #2b4889 !important;\n}\n\ntr.disabled .child-slider >>> .v-slider .v-slider__thumb-container {\n  display: none;\n}\n\ntr.disabled {\n  background-image: repeating-linear-gradient(\n    -45deg,\n    transparent,\n    transparent 35px,\n    rgba(0, 0, 0, 0.025) 35px,\n    rgba(0, 0, 0, 0.025) 70px\n  ) !important;\n}\n\ntr.disabled .child-slider >>> .v-slider .v-slider__track__container {\n  /*noinspection CssUnresolvedCustomProperty*/\n  background: linear-gradient(\n    to right,\n    rgba(219, 74, 54, 0.4) 0%,\n    rgba(219, 74, 54, 0.4) var(--allocation-red-pct, 0%),\n    rgba(47, 153, 151, 0.4) var(--allocation-red-pct, 0%),\n    rgba(47, 153, 151, 0.4) var(--allocation-green-pct, 0%),\n    rgba(255, 255, 255, 0.4) var(--allocation-green-pct, 0%),\n    rgba(255, 255, 255, 0.4) 100%\n  );\n  border: 1px solid rgba(0, 0, 0, 0.4);\n}\n</style>\n\n<script>\nimport { mapGetters } from \"vuex\";\nimport ActiveMarketsItemAdvanced from \"./ActiveMarketsItemAdvanced\";\nimport { bugsnagClient } from \"~/plugins\";\nimport swal from \"sweetalert2\";\nimport axios from \"axios\";\nimport marketToggler from \"../../mixins/marketToggler\";\n\nexport default {\n  components: {\n    ActiveMarketsItemAdvanced\n  },\n  props: {\n    baseCurrency: String,\n    exchange: String,\n    markets: Array\n  },\n  data: function() {\n    return {\n      tableHeaders: [\n        {\n          text: \"Target allocation (%)\",\n          value: \"allocation\",\n          sortable: false\n        },\n        { text: null, value: \"allocation\", sortable: false },\n        { text: \"Options\", value: null, sortable: false }\n      ]\n    };\n  },\n  computed: {\n    bigSliderValue() {\n      const baseValue = this.currentSellsPct; // 10.6462%\n      const enabledMarkets = this.markets.filter(\n        m =>\n          m.enabled &&\n          m.base_currency === this.baseCurrency &&\n          m.exchange === this.exchange\n      );\n\n      let baseValueForMarket = 0,\n        diffBetweenAllocationAndSum = 0,\n        returnValue = baseValue;\n\n      for (let enabledMarket of enabledMarkets) {\n        baseValueForMarket = this.getSellPct(\n          enabledMarket.exchange,\n          enabledMarket.name\n        );\n\n        diffBetweenAllocationAndSum =\n          enabledMarket.allocation - baseValueForMarket;\n\n        returnValue +=\n          diffBetweenAllocationAndSum > 0 ? diffBetweenAllocationAndSum : 0;\n      }\n\n      return returnValue <= 100 ? returnValue : 100;\n    },\n    currentBuysPct() {\n      return this.summedBuysPct.hasOwnProperty(this.exchange) &&\n        this.summedBuysPct[this.exchange].hasOwnProperty(this.baseCurrency)\n        ? this.summedBuysPct[this.exchange][this.baseCurrency]\n        : 0;\n    },\n    currentSellsPct() {\n      return this.summedSellsPct.hasOwnProperty(this.exchange) &&\n        this.summedSellsPct[this.exchange].hasOwnProperty(this.baseCurrency)\n        ? this.summedSellsPct[this.exchange][this.baseCurrency]\n        : 0;\n    },\n    allocationLeft: function() {\n      let result = {};\n\n      // 100 - allocation\n      Object.keys(this.totalAllocations).map((exchange, index) => {\n        result[exchange] = [];\n        Object.keys(this.totalAllocations[exchange]).map((base, index) => {\n          result[exchange][base] = 100 - this.totalAllocations[exchange][base];\n        });\n      });\n\n      return result;\n    },\n    summedBuysPct() {\n      return this.sumOnBaseCurrencyProperty(\"open_buys_alloc_perc\");\n    },\n    summedSellsPct() {\n      return this.sumOnBaseCurrencyProperty(\"open_sells_alloc_perc\");\n    },\n    ...mapGetters({\n      totalAllocations: \"markets/totalAllocations\",\n      allocationData: \"markets/allocations\"\n    })\n  },\n  created() {\n    const allocations = this.$store.getters[\"markets/allocations\"];\n\n    if (allocations.data.length === 0 && allocations.isFetching === false) {\n      this.$store.dispatch(\"markets/fetchAllocations\");\n    }\n  },\n  mixins: [marketToggler],\n  methods: {\n    sortMarketsOnEnabled(markets) {\n      return markets.sort((a, b) => {\n        if (a.enabled === b.enabled) {\n          return 0;\n        }\n\n        return a.enabled < b.enabled ? 1 : -1;\n      });\n    },\n    getBuyPct(exchange, market) {\n      const item = this.allocationData.data.find(\n        item => item.exchange === exchange && item.market_name === market\n      );\n\n      if (item !== undefined) {\n        return item.open_buys_alloc_perc;\n      }\n\n      return 0;\n    },\n    getSellPct(exchange, market) {\n      const item = this.allocationData.data.find(\n        item => item.exchange === exchange && item.market_name === market\n      );\n\n      if (item !== undefined) {\n        return item.open_sells_alloc_perc;\n      }\n\n      return 0;\n    },\n    sumOnBaseCurrencyProperty(property) {\n      return this.allocationData.data.reduce((data, item) => {\n        if (!data.hasOwnProperty(item.exchange)) {\n          data[item.exchange] = {};\n        }\n\n        if (!data[item.exchange].hasOwnProperty(item.base_currency)) {\n          data[item.exchange][item.base_currency] = 0;\n        }\n\n        data[item.exchange][item.base_currency] += item[property];\n\n        return data;\n      }, {});\n    },\n    saveAllocation: _.debounce(async function(event, market) {\n      let targetAllocation = market.allocation;\n\n      if (isNaN(targetAllocation)) {\n        targetAllocation = 0;\n      }\n\n      if (\n        this.totalAllocations.hasOwnProperty(market.exchange) &&\n        this.totalAllocations[market.exchange].hasOwnProperty(\n          market.base_currency\n        ) &&\n        this.totalAllocations[market.exchange][market.base_currency] > 100\n      ) {\n        targetAllocation -=\n          this.totalAllocations[market.exchange][market.base_currency] - 100;\n      }\n\n      this.$store.dispatch(\"markets/updateMarketAllocation\", {\n        exchange: market.exchange,\n        baseCurrency: market.base_currency,\n        name: market.name,\n        pct: targetAllocation\n      });\n\n      try {\n        await axios.put(\n          \"/api/v1/markets/\" + market.name + \"/percent/\" + targetAllocation\n        );\n      } catch (error) {\n        // recover\n        this.$store.dispatch(\"markets/fetchMarkets\");\n\n        await swal({\n          title: \"Problem saving allocation\",\n          type: \"error\"\n        });\n\n        bugsnagClient.notify(error);\n      }\n    }, 1000)\n  }\n};\n</script>\n\n\n\n// WEBPACK FOOTER //\n// resources/js/components/markets/ActiveMarkets.vue","var render = function () {var _vm=this;var _h=_vm.$createElement;var _c=_vm._self._c||_h;return _c('v-card',{attrs:{\"disabled\":_vm.loading}},[_c('v-card-title',[_c('h1',[_vm._v(\"Add a manual entry\")])]),_vm._v(\" \"),_c('v-card-text',[_c('p',[_vm._v(\"\\n      Here you may add an historic buy order to the buy history. The bot will\\n      then treat it is as if it had placed the original order itself.\\n    \")]),_vm._v(\" \"),_c('p',[_vm._v(\"\