body {\n  margin: 0 auto;\n  width: 100%;\n  min-width: 0\n}\n\n@media screen and (min-width: 960px) {\n  #cookie_banner .body {\n    width: auto\n  }\n}\n\n#cookie_banner .content {\n  position: relative;\n  display: flex;\n  flex-direction: column\n}\n\n#cookie_banner .description {\n  margin: 0 0 12px 0\n}\n\n@media screen and (min-width: 960px) {\n  #cookie_banner .description {\n    margin: 0 16px 0 0;\n    word-wrap: normal;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap\n  }\n}\n\n@media screen and (min-width: 960px) {\n  #cookie_banner .content {\n    flex-direction: row;\n    flex-wrap: nowrap;\n    align-items: center\n  }\n}\n\n#cookie_banner .description {\n  white-space: normal;\n  overflow-wrap: break-word;\n  word-wrap: break-word;\n  word-break: normal;\n  line-height: inherit;\n  margin: 0 0 16px 0;\n}\n\n#cookie_banner .description a {\n  vertical-align: baseline;\n  text-decoration: underline\n}\n\n#cookie_banner .form {\n  display: flex;\n  flex-direction: row;\n  align-items: flex-end;\n  width: 100%\n}\n\n@media screen and (min-width: 960px) {\n  #cookie_banner .form {\n    width: auto;\n    max-width: 100%\n  }\n}\n\n#cookie_banner .buttons {\n  display: flex;\n  flex-direction: row;\n  flex-wrap: nowrap;\n}\n\n#cookie_banner .buttons .button.icon {\n  flex-shrink: 0;\n  flex-grow: 0\n}\n\n#cookie_banner .button {\n  text-decoration: none;\n  display: block;\n  border: solid 1px transparent;\n  outline: 0;\n  font-family: inherit;\n  font-weight: bold;\n  border-radius: 4px;\n  transition: background-color 0.2s ease-out;\n  line-height: 1.5;\n  padding: 11px 23px;\n  word-wrap: normal;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap\n}\n\n#cookie_banner .button > * {\n  min-width: 0\n}\n\n#cookie_banner .button::-moz-focus-inner {\n  padding: 0;\n  border: 0\n}\n\n#cookie_banner .button:hover,\n#cookie_banner .button:focus,\n#cookie_banner .button:active,\n#cookie_banner .button:disabled {