var state = {
  markets: null,
  marketsAll: null,
  marketsProfits: null,
  marketsProfitsLastMonth: null,
  marketsProfitsTotal: null,
  allocations: {
    data: [],
    lastUpdated: null,
    isFetching: false
  }
};

// getters
var getters = {
  markets: function markets(state) {
    return state.markets;
  },
  marketsAll: function marketsAll(state) {
    return state.marketsAll;
  },
  marketsProfits: function marketsProfits(state) {
    return state.marketsProfits;
  },
  marketsProfitsLastMonth: function marketsProfitsLastMonth(state) {
    return state.marketsProfitsLastMonth;
  },
  marketsProfitsTotal: function marketsProfitsTotal(state) {
    if (state.marketsProfits) {
      return state.marketsProfits;
    }
    if (state.marketsProfitsLastMonth) {
      return state.marketsProfitsLastMonth;
    }
    return {
      Binance: null,
      Bittrex: null,
      Huobi: null
    };
  },
  allocations: function allocations(state) {
    return state.allocations;
  },
  exchanges: function exchanges(state) {
    if (state.markets === null) {
      return []; // not available (yet)
    }

    return Object.keys(state.markets);
  },
  enabledMarkets: function enabledMarkets(state) {
    var result = {};

    if (state.markets === null) {
      return [];
    }

    Object.keys(state.markets).map(function (exchange, index) {
      result[exchange] = [];
      Object.keys(state.markets[exchange]).map(function (base, index) {
        result[exchange][base] = state.markets[exchange][base].filter(function (market) {
          return market.enabled === true;
        });
      });
    });

    return result;
  },
  totalAllocations: function totalAllocations(state) {
    var result = {};
    if (state.markets === null) {
