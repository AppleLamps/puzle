p>\n        <v-text-field\n          ref=\"social-media-text\"\n          v-model=\"textSocialMedia\"\n          append-outer-icon=\"fas fa-copy\"\n          prepend-icon=\"fas fa-hashtag\"\n          box\n          label=\"Social Media\"\n          type=\"text\"\n          @click:append-outer=\"copyCode('social-media-text')\"\n        ></v-text-field>\n      </p>\n      <p>\n        <v-text-field\n          ref=\"image-url\"\n          v-model=\"textImageUrl\"\n          append-outer-icon=\"fas fa-copy\"\n          prepend-icon=\"fas fa-image\"\n          box\n          label=\"Image URL\"\n          type=\"text\"\n          @click:append-outer=\"copyCode('image-url')\"\n        ></v-text-field>\n      </p>\n      <p>\n        <ShareNetwork\n          network=\"twitter\"\n          :url=\"publicUrl\"\n          :title=\"socialMediaTitle\"\n          twitter-user=\"GSMG_Bot\"\n          hashtags=\"GSMG,cryptotrading,algotrading\"\n          :style=\"{ backgroundColor: '#1da1f2' }\"\n        >\n          <i class=\"fab fah fa-lg fa-twitter\"></i>\n          <span>Share on Twitter</span>\n        </ShareNetwork>\n\n        <ShareNetwork\n          network=\"telegram\"\n          :url=\"publicUrl\"\n          :title=\"socialMediaTitle\"\n          :style=\"{ backgroundColor: '#0088cc' }\"\n        >\n          <i class=\"fab fah fa-lg fa-telegram-plane\"></i>\n          <span>Share on Telegram</span>\n        </ShareNetwork>\n\n        <ShareNetwork\n          network=\"facebook\"\n          :url=\"publicUrl\"\n          :quote=\"socialMediaTitle\"\n          :title=\"socialMediaTitle\"\n          hashtags=\"GSMG,cryptotrading,algotrading\"\n          :style=\"{ backgroundColor: '#1877f2' }\"\n        >\n          <i class=\"fab fah fa-lg fa-facebook-f\"></i>\n          <span>Share on Facebook</span>\n        </ShareNetwork>\n      </p>\n    </v-card-text>\n    <v-card-actions>\n      <v-spacer></v-spacer>\n      <v-btn flat=\"flat\" @click.native=\"$emit('close-dialog')\">Close</v-btn>\n    </v-card-actions>\n  </v-card>\n</template>\n\n<style>\na[class^=\"share-network-\"] {\n  color: #ffffff;\n  border-radius: 3px;\n  overflow: hidden;\n  display: inline-block;\n  align-content: center;\n  align-items: center;\n  cursor: pointer;\n  margin: 0 10px 10px 0;\n  width: 180px;\n}\na[class^=\"share-network-\"] .fah {\n  background-color: rgba(0, 0, 0, 0.2);\n  padding: 10px;\n  /*flex: 0 1 auto;*/\n}\na[class^=\"share-network-\"] span {\n  padding: 0 10px;\n  /*flex: 1 1 0%;*/\n  font-weight: 500;\n}\n</style>\n\n<script>\nimport axios from \"axios\";\nimport moment from \"moment-timezone/builds/moment-timezone-with-data-10-year-range\";\nimport swal from \"sweetalert2\";\nimport { bugsnagClient } from \"~/plugins\";\n\nexport default {\n  name: \"Share\",\n  props: {\n    metric: {\n      type: String,\n      required: true\n    }\n  },\n  data() {\n    return {\n      metadata: [],\n      loading: true,\n      textSocialMedia: null,\n      textImageUrl: null,\n      imageUrl: null,\n      imageSrc: null,\n      publicUrl: \"https://gsmg.io/\"\n    };\n  },\n  watch: {\n    metric() {\n      this.reset();\n      this.loadData();\n    },\n    publicUrl() {\n      if (this.loading) {\n        return;\n      }\n\n      this.textSocialMedia = `${this.socialMediaTitle} #GSMG #cryptotrading #algotrading ${this.publicUrl}`;\n      this.textImageUrl = this.imageUrl;\n    }\n  },\n  created() {\n    this.reset();\n  },\n  mounted() {\n    this.loadData();\n  },\n  computed: {\n    socialMediaTitle() {\n      return \"A.I. is taking over, look at it taking over my life. No pain just gain.\";\n    }\n  },\n  methods: {\n    async loadData() {\n      try {\n        const { data } = await axios.post(\"/api/v1/generate-share-image\", {\n          metric: this.metric,\n          tz: moment.tz.guess()\n        });\n\n        this.loading = false;\n        this.imageSrc = \"data:image/png;base64,\" + data.base64;\n        this.publicUrl = data.url;\n        this.imageUrl = data.image_url;\n        this.metadata = data.metadata;\n      } catch (error) {\n        await swal({\n          title: \"Problem getting an image to share\",\n          type: \"error\"\n        });\n\n        bugsnagClient.notify(error);\n      }\n    },\n    reset() {\n      this.loading = true;\n      this.textSocialMedia = \"Loading..\";\n      this.textImageUrl = \"Loading..\";\n      this.imageUrl = null;\n      this.publicUrl = \"https://gsmg.io\";\n      this.metadata = [];\n      this.imageSrc =\n        \"data:image/jpeg;base64,\";\n    },\n    copyCode(ref) {\n      const textToCopy = this.$refs[ref].$el.querySelector(\"input\");\n      textToCopy.select();\n      document.execCommand(\"copy\");\n    }\n  }\n};\n</script>\n\n<style scoped></style>\n\n\n\n// WEBPACK FOOTER //\n// resources/js/components/dashboard/Share.vue","var render = function () {var _vm=this;var _h=_vm.$createElement;var _c=_vm._self._c||_h;return _c('v-container',{style:({ maxWidth: '1200px' }),attrs:{\"fluid\":\"\",\"grid-list-md\":\"\"}},[_c('v-layout',{attrs:{\"row\":\"\",\"wrap\":\"\"}},[_c('v-flex',{attrs:{\"xs12\":\"\",\"md12\":\"\",\"lg12\":\"\"}},[_c('v-card',{attrs:{\"height\":\"100%\"}},[_c('v-toolbar',{attrs:{\"color\":\"secondary\",\"dark\":\"\"}},[_c('v-toolbar-title',[_vm._v(\"Chart\")]),_vm._v(\" \"),_c('v-spacer'),_vm._v(\" \"),_c('v-flex',{attrs:{\"xs8\":\"\",\"sm4\":\"\",\"d-flex\":\"\"}},[_c('v-select',{attrs:{\"items\":_vm.activeMarkets,\"label\":\"Market\"},on:{\"change\":_vm.loadOpenOrders}})],1)],1),_vm._v(\" \"),_c('v-card-text',[(_vm.selectedMarket)?_c('StockChart',{attrs:{\"market\":_vm.selectedMarket,\"sell-orders\":_vm.sellOrderLevels,\"buy-orders\":_vm.buyOrderLevels,\"closed-sell-orders\":_vm.closedSellOrders,\"closed-buy-orders\":_vm.closedBuyOrders}}):_c('div',[_vm._v(\"Please select a market first...\")])],1)],1)],1)],1),_vm._v(\" \"),_c('v-layout',{staticClass:\"wrap\",attrs:{\"row\":\"\"}},[_c('v-flex',{attrs:{\"xs12\":\"\