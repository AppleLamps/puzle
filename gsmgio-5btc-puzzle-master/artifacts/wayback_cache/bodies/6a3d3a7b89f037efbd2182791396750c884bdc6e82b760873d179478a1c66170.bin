Show ? 'visibility_off' : 'visibility'\n            \"\n            :type=\"disableForm.passwordShow ? 'text' : 'password'\"\n            name=\"disableFormPassword\"\n            label=\"Password *\"\n            @click:append=\"disableForm.passwordShow = !disableForm.passwordShow\"\n          ></v-text-field>\n          <v-text-field\n            v-model=\"disableForm.code\"\n            name=\"disableFormCode\"\n            label=\"2-fa code *\"\n          ></v-text-field>\n        </div>\n\n        <v-btn color=\"primary\" :disabled=\"loading\" @click=\"disable\"\n          >Disable</v-btn\n        >\n        <v-btn flat @click=\"stepper = 1\">Back</v-btn>\n      </v-stepper-content>\n\n      <v-stepper-content step=\"3\">\n        <p>\n          2-factor authentication is now disabled.\n          <a @click=\"reload\">Reload</a> the page if you want to re-enable\n          2-factor authentication.\n        </p>\n      </v-stepper-content>\n    </v-stepper-items>\n  </v-stepper>\n</template>\n\n<script>\nimport axios from \"axios\";\nimport swal from \"sweetalert2\";\n\nexport default {\n  name: \"TwoFactorDisable\",\n  data: function() {\n    return {\n      loading: false,\n      stepper: 0,\n      disableForm: {\n        password: null,\n        passwordShow: false,\n        code: null\n      }\n    };\n  },\n  methods: {\n    reload: function() {\n      window.location.reload();\n    },\n    disable: async function() {\n      this.loading = true;\n\n      try {\n        await axios.post(\"api/v1/two-factor/disable\", {\n          \"2fa_code\": this.disableForm.code,\n          password: this.disableForm.password\n        });\n\n        this.loading = false;\n        this.stepper = 3;\n\n        return true;\n      } catch (error) {\n        swal({\n          title: \"Something went wrong\",\n          text:\n            \"Please enter your password and a valid 2-factor code using the authenticator app.\",\n          type: \"error\"\n        });\n\n        thi