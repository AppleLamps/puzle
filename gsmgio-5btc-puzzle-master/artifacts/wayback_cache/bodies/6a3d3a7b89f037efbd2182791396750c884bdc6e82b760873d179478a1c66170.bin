_SUCCESS = \"FETCH_RECENT_PROFITS_SUCCESS\";\nexport const FETCH_RECENT_PROFITS_FAILURE = \"FETCH_RECENT_PROFITS_FAILURE\";\nexport const FETCH_ALL_TIME_PROFITS_SUCCESS = \"FETCH_ALL_TIME_PROFITS_SUCCESS\";\nexport const FETCH_ALL_TIME_PROFITS_FAILURE = \"FETCH_ALL_TIME_PROFITS_FAILURE\";\n\n\n\n// WEBPACK FOOTER //\n// ./resources/js/store/accountValueTypes.js","import axios from \"axios\";\nimport * as types from \"../accountValueTypes\";\nimport { bugsnagClient } from \"~/plugins\";\nimport moment from \"moment-timezone/builds/moment-timezone-with-data-10-year-range\";\n\n// Default state\nexport const state = {\n  profit_trades_last_week: [],\n  recent_profits_per_base_currency: [],\n  all_time_profits_per_base_currency: [],\n  value: {\n    Binance: {},\n    Bittrex: {}\n  },\n  managedValueHistory: {},\n  accountValueHistory: {\n    BTC: { Bittrex: {}, Binance: {} },\n    USD: { Bittrex: {}, Binance: {} }\n  }\n};\n\n// Getters: return computed state\nexport const getters = {\n  values: state => {\n    return state.value;\n  },\n  managed_value_history: state => {\n    return state.managedValueHistory;\n  },\n  account_value_history: state => {\n    return state.accountValueHistory;\n  },\n  recent_profits_per_base_currency: state => {\n    return state.recent_profits_per_base_currency;\n  },\n  all_time_profits_per_base_currency: state => {\n    return state.all_time_profits_per_base_currency;\n  },\n  profit_trades_last_week: state => {\n    if (!state.profit_trades_last_week) {\n      return [];\n    }\n\n    let tradeData = {};\n    for (let timestamp of state.profit_trades_last_week) {\n      let ts = moment\n        .utc(String(timestamp))\n        .tz(moment.tz.guess())\n        .format(\"YYYY-MM-DD\");\n\n      if (!tradeData[ts]) {\n        tradeData[ts] = 0;\n      }\n\n      tradeData[ts]++;\n    }\n\n    let dayData = {},\n      str;\n\n    for (let offset of Array(7).keys()) {\n      str = moment()\n        .subtract(offset, \"day\")\n        .format(\"YYYY-MM-DD\");\n\n      dayData[str] = !tradeData[str] ? 0 : tradeData[str];\n    }\n\n    return dayData;\n  }\n};\n\n// Mutate the state\nexport const mutations = {\n  [types.FETCH_ACCOUNT_VALUE_SUCCESS](state, { result }) {\n    state.value.Binance = result.account_value.Binance\n      ? result.account_value.Binance\n      : {};\n    state.value.Bittrex = result.account_value.Bittrex\n      ? result.account_value.Bittrex\n      : {};\n\n    state.managedValueHistory = result.managed_value_history;\n    state.accountValueHistory = result.account_value_history;\n  },\n  [types.FETCH_ACCOUNT_VALUE_FAILURE]() {},\n  [types.FETCH_PROFIT_TRADES_LAST_WEEK_SUCCESS](\n    state,\n    { profit_trades_last_week }\n  ) {\n    state.profit_trades_last_week = profit_trades_last_week;\n  },\n  [types.FETCH_PROFIT_TRADES_LAST_WEEK_FAILURE](state) {\n    state.profit_trades_last_week = [];\n  },\n  [types.FETCH_RECENT_PROFITS_SUCCESS](state, { profits_per_base_currency }) {\n    state.recent_profits_per_base_currency = profits_per_base_currency;\n  },\n  [types.FETCH_RECENT_PROFITS_FAILURE](state) {\n    state.recent_profits_per_base_currency = [];\n  },\n  [types.FETCH_ALL_TIME_PROFITS_SUCCESS](state, { profits_per_base_currency }) {\n    state.all_time_profits_per_base_currency = profits_per_base_currency;\n  },\n  [types.FETCH_ALL_TIME_PROFITS_FAILURE](state) {\n    state.all_time_profits_per_base_currency = [];\n  }\n};\n\n// Perform async actions / api calls\nexport const actions = {\n  async fetchAll({ dispatch }) {\n    dispatch(\"fetchAccountValue\");\n    dispatch(\"fetchProfitableTradesLastWeek\");\n    dispatch(\"fetchRecentProfitsPerBaseCurrency\");\n    dispatch(\"fetchAllTimeProfitsPerBaseCurrency\");\n  },\n\n  async fetchAccountValue({ commit }) {\n    try {\n      const { data } = await axios.get(\"/api/v1/user/account-value\");\n\n      commit(types.FETCH_ACCOUNT_VALUE_SUCCESS, { result: data.data });\n    } catch (error) {\n      commit(types.FETCH_ACCOUNT_VALUE_FAILURE);\n\n      bugsnagClient.notify(error);\n    }\n  },\n  async fetchProfitableTradesLastWeek({ commit }) {\n    try {\n      const { data } = await axios.get(\"/api/v1/values/trades-this-week\");\n\n      commit(types.FETCH_PROFIT_TRADES_LAST_WEEK_SUCCESS, {\n        profit_trades_last_week: data\n      });\n    } catch (e) {\n      commit(types.FETCH_PROFIT_TRADES_LAST_WEEK_FAILURE);\n    }\n  },\n  async fetchRecentProfitsPerBaseCurrency({ commit }) {\n    try {\n      const { data } = await axios.get(\n        \"/api/v1/values/profits-per-base-currency/recent\"\n      );\n\n      commit(types.FETCH_RECENT_PROFITS_SUCCESS, {\n        profits_per_base_currency: data\n      });\n    } catch (e) {\n      commit(types.FETCH_RECENT_PROFITS_FAILURE);\n    }\n  },\n  async fetchAllTimeProfitsPerBaseCurrency({ commit }) {\n    try {\n      const { data } = await axios.get(\n        \"/api/v1/values/profits-per-base-currency/all-time\"\n      );\n\n      commit(types.FETCH_ALL_TIME_PROFITS_SUCCESS, {\n        profits_per_base_currency: data\n      });\n    } catch (e) {\n      commit(types.FETCH_ALL_TIME_PROFITS_FAILURE);\n    }\n  }\n};\n\n\n\n// WEBPACK FOOTER //\n// ./resources/js/store/modules/accountValue.js","exports = module.exports = require(\"../../../../node_modules/css-loader/lib/css-base.js\")(false);\n// imports\n\n\n// module\nexports.push([module.id, \"\", \"\"]);\n\n// exports\n\n\n\n//////////////////\n// WEBPACK FOOTER\n// ./node_modules/css-loader?minimize!./node_modules/vue-loader/lib/style-compiler?{\"vue\":true,\"id\":\"data-v-827887f6\",\"scoped\":true,\"hasInlineConfig\":true}!./node_modules/vue-loader/lib/selector.js?type=styles&index=1!./resources/js/components/dashboard/Share.vue\n// module id = /d0M\n// module chunks = 0","<script>\nimport { Line, mixins } from \"vue-chartjs\";\n\nexport default {\n  extends: Line,\n  mixins: [mixins.reactiveProp],\n  props: {\n    label: {\n      type: String,\n      default: \"BTC\"\n    }\n  },