le primary-title>\n            <h1 class=\"headline\">Enable gracefull shutdown mode</h1>\n          </v-card-title>\n          <v-card-text>\n            <v-layout>\n              <v-flex>\n                <p>Enable the gracefull shutdown mode?</p>\n                <v-switch\n                  :input-value=\"settings.stop_tradeengines || false\"\n                  @change=\"setGracefulShutdownMode($event)\"\n                ></v-switch>\n              </v-flex>\n            </v-layout>\n          </v-card-text>\n        </v-card>\n\n        <v-card>\n          <v-card-title primary-title>\n            <h1 class=\"headline\">Generate invites</h1>\n          </v-card-title>\n          <v-card-text>\n            <v-layout>\n              <v-flex sm12>\n                <v-text-field\n                  v-model=\"invites_name\"\n                  label=\"Name\"\n                ></v-text-field>\n              </v-flex>\n              <v-flex sm6>\n                <v-text-field\n                  v-model.number=\"invites_count\"\n                  mask=\"##\"\n                  label=\"Amount\"\n                ></v-text-field>\n              </v-flex>\n              <v-flex sm6 class=\"text-xs-right\">\n                <v-btn dark color=\"primary\" @click=\"generateInvites\"\n                  >Generate</v-btn\n                >\n              </v-flex>\n            </v-layout>\n          </v-card-text>\n        </v-card>\n      </v-flex>\n      <v-flex sm12 md8>\n        <v-card>\n          <v-card-title primary-title>\n            <h1 class=\"headline\">Users</h1>\n          </v-card-title>\n          <v-card-text>\n            <v-text-field\n              v-model=\"userSearch\"\n              append-icon=\"search\"\n              label=\"Search\"\n              single-line\n              hide-details\n            ></v-text-field>\n            <v-data-table\n              :items=\"users || []\"\n              :headers=\"userTableHeaders\"\n              :search=\"userSearch\"\n            >\n              <template slot=\"items\" slot-scope=\"props\">\n                <td>{{ props.item.id }}</td>\n                <td>{{ props.item.email }}</td>\n                <td>{{ props.item.created_at }}</td>\n                <td>\n                  <v-switch\n                    :input-value=\"props.item.activated\"\n                    @change=\"toggleUserActivation($event, props.item)\"\n                  ></v-switch>\n                </td>\n                <td>\n                  <v-switch\n                    v-if=\"props.item.front_end_settings\"\n                    :input-value=\"props.item.front_end_settings.trade_engine_on\"\n                    @change=\"toggleUserEngine($event, props.item)\"\n                  ></v-switch>\n                </td>\n              </template>\n            </v-data-table>\n          </v-card-text>\n        </v-card>\n      </v-flex>\n    </v-layout>\n  </v-container>\n</template>\n\n<script>\nimport axios from \"axios\";\nimport swal from \"sweetalert2\";\n\nexport default {\n  data: function() {\n    return {\n      invites_count: 1,\n      invites_name: \"\",\n      users: null,\n      settings: {},\n      userTableHeaders: [\n        {\n          text: \"ID\",\n          value: \"id\"\n        },\n        {\n          text: \"E-Mail\",\n          value: \"email\"\n        },\n        {\n          text: \"Registered at\",\n          value: \"created_at\"\n        },\n        {\n          text: \"Activated\",\n          value: \"activated\"\n        },\n        {\n          text: \"Engine status\",\n          value: \"front_end_settings.trade_engine_on\"\n        }\n      ],\n      userSearch: \"\"\n    };\n  },\n\n  mounted: async function() {\n    axios.get(\"/api/v1/admin/users\").then(res => {\n      this.users = res.data;\n    });\n\n    axios.get(\"/api/v1/admin/settings\").then(res => {\n      this.settings = res.data || {};\n    });\n  },\n\n  methods: {\n    generateInvites: async function() {\n      const { data } = await axios.post(\"/api/v1/admin/generateInvite\", {\n        name: this.invites_name,\n        count: this.invites_count\n      });\n\n      const urls = data.join(\"<br>\");\n\n      await swal({\n        title: \"Invites generated\",\n        html: urls,\n        type: \"success\",\n        width: \"80%\"\n      });\n    },\n    toggleUserEngine: async function(e, user) {\n      try {\n        const { data } = await axios.post(\n          \"/api/v1/admin/toggleUserEngine/\" + user.id\n        );\n        user.activated = data.activated;\n        user.front_end_settings.trade_engine_on =\n          data.front_end_settings.trade_engine_on;\n      } catch (error) {\n        await swal({\n          title: \"User is unable to trade\",\n          text:\n            \"This use is unable to trade at this moment (no / wrong api keys?)\",\n          type: \"error\"\n        });\n\n        return false;\n      }\n    },\n    toggleUserActivation: async function(e, user) {\n      try {\n        const { data } = await axios.post(\n          \"/api/v1/admin/toggleUserActivation/\" + user.id\n        );\n        user.activated = data.activated;\n        user.front_end_settings.trade_engine_on =\n          data.front_end_settings.trade_engine_on;\n      } catch (error) {\n        await swal({\n          title: \"Unable to activate user\",\n          text: \"This shouldn't happen\",\n          type: \"error\"\n        });\n\n        return false;\n      }\n    },\n    setGracefulShutdownMode: async function(e) {\n      // confirm\n      let confirmation = await swal({\n        title: \"Warning\",\n        text: \"This will \" + (e ? \"halt\" : \"start\") + \" all trading. \",\n        type: \"warning\",\n        showCancelButton: true\n      });\n\n      if (confirmation.dismiss) {\n        return false;\n      }\n\n      try {\n        const mode = e === true ? 1 : 0;\n\n        await axios.post(\"/api/v1/admin/setgracefulshutdownmode/\" + mode);\n\n        this.settings.stop_tradeengines = e;\n      } catch (e) {\n        console.log(e);\n      }\n    }\n  }\n};\n</script>\n\n\n\n// WEBPACK FOOTER //\n// resources/js/pages/admin.vue","var render = function () {var _vm=this;var _h=_vm.$createElement;var _c=_vm._self._c||_h;return _c('v-container',{style:({ maxWidth: '1200px' }),attrs:{\"fluid\":\"\"}},[_c('v-layout',{attrs:{\"flex\":\"\",\"align-center\":\"\"}},[_c('v-flex',{attrs:{\"xs12\":\"\",\"sm6\":\"\",\"md4\":\"\",\"offset-sm3\":\"\",\"offset-md4\":\"\"}},[_c('v-card',[_c('v-card-title',{attrs:{\"primary-title\":\"\"}},[_c('h1',{staticClass:\"headline\"},[_vm._v(\"Reset password\")])]),_vm._v(\" \"),_c('v-card-text',[_c('v-form',{on:{\"submit\":function($event){$event.preventDefault();return _vm.reset($event)},\"keydown\":function($event){return _vm.form.onKeydown($event)}}},[_c('p',[_vm._v(_vm._s(_vm.status))]),_vm._v(\" \"),_c('v-text-field',{attrs:{\"label\":\"E-Mail\",\"placeholder\":\"E-Mail\",\"prepend-icon\":\"fa-envelope-o\",\"single-line\":\"\",\"required\":\"\",\"autofocus\":\"\",\"error\":_vm.form.errors.has('email')},model:{value:(_vm.form.email),callback:function ($$v) {_vm.$set(_vm.form, \"email\", $$v)},expression:\"form.email\"}}),_vm._v(\" \"),_c('has-error',{attrs:{\"form\":_vm.form,\"field\":\"email\"}}),_vm._v(\" \"),_c('v-text-field',{attrs:{\"label\":\"Password\",\"type\":\"password\",\"placeholder\":\"Password\",\"prepend-icon\":\"fa-unlock-alt\",\"single-line\":\"\",\"required\":\"\",\"error\":_vm.form.errors.has('password')},model:{value:(_vm.form.password),callback:function ($$v) {_vm.$set(_vm.form, \"password\", $$v)},expression:\"form.password\"}}),_vm._v(\" \"),_c('has-error',{attrs:{\"form\":_vm.form,\"field\":\"password\"}}),_vm._v(\" \"),_c('v-text-field',{attrs:{\"label\":\"Password confirmation\",\"type\":\"password\",\"placeholder\":\"Password confirmation\",\"prepend-icon\":\"fa-unlock-alt\",\"single-line\":\"\",\"required\":\"\",\"error\":_vm.form.errors.has('password_c