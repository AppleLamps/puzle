n      { text: \"Configured alloc (%)\", value: \"set_alloc_perc\" }\n    ]\n  }),\n  computed: {\n    chartData: function() {\n      let chartOptions = {\n        chart: {\n          type: \"bar\",\n          height: \"700px\",\n          backgroundColor: this.darkmode ? \"#424242\" : \"#fff\"\n        },\n        title: {\n          text: \"Market Allocations\",\n          style: {\n            color: this.darkmode ? \"white\" : \"#333\"\n          }\n        },\n        xAxis: {\n          categories: [],\n          labels: {\n            style: {\n              color: this.darkmode ? \"white\" : \"#333\"\n            }\n          }\n        },\n        yAxis: {\n          min: 0,\n          title: {\n            text: \"Total allocation (%)\",\n            style: {\n              color: this.darkmode ? \"white\" : \"#333\"\n            }\n          },\n          labels: {\n            style: {\n              color: this.darkmode ? \"white\" : \"#333\"\n            }\n          }\n        },\n        legend: {\n          reversed: true,\n          itemStyle: {\n            color: this.darkmode ? \"white\" : \"#333\"\n          }\n        },\n        plotOptions: {\n          series: {\n            stacking: \"normal\"\n          }\n        },\n        series: [\n          {\n            name: \"Buy\",\n            data: [],\n            color: this.$vuetify.theme.success,\n            tooltip: {\n              headerFormat: \"\",\n              pointFormat: \"{point.y:.0f}%\"\n            },\n            dataLabels: {\n              enabled: true,\n              color: \"#FFFFFF\",\n              format: \"{point.y:.0f}%\", // 0 decimal\n              style: {\n                fontSize: \"9px\",\n                fontFamily: \"Verdana, sans-serif\"\n              }\n            }\n          },\n          {\n            name: \"Sell\",\n            data: [],\n            color: this.$vuetify.theme.error,\n            tooltip: {\n              headerFormat: \"\",\n 