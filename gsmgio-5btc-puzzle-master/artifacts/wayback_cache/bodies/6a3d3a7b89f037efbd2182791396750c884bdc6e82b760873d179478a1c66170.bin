age the sale of it, taking advantage, among other things, of the\n        trailing stop, for example.\n      </p>\n      <p v-if=\"!confirming\">\n        <v-form ref=\"form\" v-model=\"formValidated\">\n          <v-autocomplete\n            v-model=\"selectedMarketName\"\n            :items=\"marketsFlattened\"\n            clearable\n            hide-details\n            hide-selected\n            item-text=\"name\"\n            item-value=\"name\"\n            label=\"Market name\"\n            class=\"mb-4\"\n            :rules=\"rules.selectedMarketName\"\n          >\n            <template v-slot:no-data>\n              <v-list-tile>\n                <v-list-tile-title>\n                  Search for a\n                  <strong>market</strong>...\n                </v-list-tile-title>\n              </v-list-tile>\n            </template>\n            <template v-slot:item=\"{ item }\">\n              <v-list-tile-avatar\n                color=\"indigo\"\n                class=\"headline font-weight-light white--text\"\n                v-if=\"item.name\"\n              >\n                {{ item.name.charAt(0) }}\n              </v-list-tile-avatar>\n              <v-list-tile-content>\n                <v-list-tile-title v-text=\"item.name\"></v-list-tile-title>\n              </v-list-tile-content>\n              <v-list-tile-action>\n                <v-icon>fas fa-coins</v-icon>\n              </v-list-tile-action>\n            </template>\n          </v-autocomplete>\n\n          <v-text-field\n            v-model=\"buyPrice\"\n            label=\"Buy price\"\n            :suffix=\"selectedMarket.base_currency\"\n            :rules=\"rules.buyPrice\"\n            required\n          ></v-text-field>\n\n          <v-text-field\n            v-model=\"quantity\"\n            label=\"Quantity\"\n            :suffix=\"selectedMarket.target_currency\"\n            :rules=\"rules.quantity\"\n            required\n          ></v-text-field>\n        </v-form>\n      </p>\n      <div v-else>\n        <h3>Confirm your input</h3>\n        <v-list>\n          <v-list-tile>\n            <v-list-tile-content>\n              <v-list-tile-title>\n                Market name\n              </v-list-tile-title>\n              <v-list-tile-sub-title>\n                {{ selectedMarketName }}\n              </v-list-tile-sub-title>\n            </v-list-tile-content>\n          </v-list-tile>\n          <v-list-tile>\n            <v-list-tile-content>\n              <v-list-tile-title>\n                Buy price\n              </v-list-tile-title>\n              <v-list-tile-sub-title>\n                {{ buyPrice }} {{ selectedMarket.base_currency }}\n              </v-list-tile-sub-title>\n            </v-list-tile-content>\n          </v-list-tile>\n          <v-list-tile>\n            <v-list-tile-content>\n              <v-list-tile-title>\n                Quantity\n              </v-list-tile-title>\n              <v-list-tile-sub-title>\n                {{ quantity }} {{ selectedMarket.target_currency }}\n              </v-list-tile-sub-title>\n            </v-list-tile-content>\n          </v-list-tile>\n        </v-list>\n      </div>\n      <p v-if=\"selectedMarketName\">\n        Please refer to the market settings for {{ selectedMarketName }} to\n        configure the bot for this market.\n      </p>\n      <p v-else>\n        Please refer to the market settings to configure the bot for this\n        market.\n      </p>\n      <p>\n        It may take up to half an hour before the bot has placed a sell order to\n        sell these funds.\n      </p>\n      <v-btn\n        color=\"primary\"\n        class=\"ml-0\"\n        :disabled=\"!formValidated\"\n        @click=\"confirm\"\n        :loading=\"loading\"\n      >\n        <v-icon left>fa fa-plus</v-icon>\n        <span v-if=\"confirming\">\n          I am sure, add manual entry\n        </span>\n        <span v-else>\n          Add manual entry\n        </span>\n      </v-btn>\n\n      <v-btn class=\"ml-1\" v-if=\"confirming\" @click=\"cancel\">\n        No, take me back\n      </v-btn>\n    </v-card-text>\n  </v-card>\n</template>\n<script>\nimport { mapGetters } from \"vuex\";\nimport axios from \"axios\";\nimport swal from \"sweetalert2\";\nimport { bugsnagClient } from \"~/plugins\";\n\nfunction prepareInputForValidation(v) {\n  if (typeof v !== \"string\" && v instanceof String === false) {\n    return \"\";\n  }\n\n  if (v.charAt(0) === \".\") {\n    v = \"0\" + v;\n  }\n\n  if (v.charAt(v.length - 1) === \".\") {\n    v = v.substring(0, v.length - 1);\n  }\n\n  return v;\n}\n\nexport default {\n  name: \"AddManualBuyOrderAccumulatedFunds\",\n  data() {\n    return {\n      loading: false,\n      selectedMarketName: null,\n      selectedMarket: {\n        base_currency: null,\n        target_currency: null,\n        name: null\n      },\n      confirming: false,\n      buyPrice: null,\n      quantity: null,\n      formValidated: false,\n      rules: {\n        buyPrice: [\n          v => !!v || \"Buy price cannot be empty\",\n          v =>\n            new RegExp(\"^\\\\d+(\\\\.\\\\d+)?$\").test(prepareInputForValidation(v)) ||\n            \"Buy price should be a number\",\n          v =>\n            parseFloat(prepareInputForValidation(v)) > 0 ||\n            \"Buy price should be above zero\"\n        ],\n        quantity: [\n          v => !!v || \"Quantity cannot be empty\",\n          v =>\n            new RegExp(\"^\\\\d+(\\\\.\\\\d+)?$\").test(prepareInputForValidation(v)) ||\n            \"Quantity should be a number\",\n          v =>\n            parseFloat(prepareInputForValidation(v)) > 0 ||\n            \"Quantity should be above zero\"\n        ],\n        selectedMarketName: [v => !!v || \"Market cannot be empty\"]\n      }\n    };\n  },\n  watch: {\n    selectedMarketName() {\n      if (\n        typeof this.selectedMarketName !== \"undefined\" &&\n        this.selectedMarketName !== null &&\n        this.sel