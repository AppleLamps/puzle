text-field>\n    <v-text-field\n      v-model=\"api_form.api_secret\"\n      label=\"API secret\"\n      name=\"api_secret\"\n      value=\"API secret\"\n      type=\"password\"\n      prepend-icon=\"fa-unlock\"\n    ></v-text-field>\n    <div class=\"text-xs-right\">\n      <v-btn color=\"primary\" dark class=\"mx-0 my-3\" @click=\"updateApiSettings\"\n        >Update API settings</v-btn\n      >\n    </div>\n\n    <v-layout v-if=\"backend_status.message\">\n      <v-flex xs4>\n        <p>Status:</p>\n      </v-flex>\n      <v-flex xs8 class=\"text-xs\">\n        <p>{{ backend_status.message }}</p>\n      </v-flex>\n    </v-layout>\n  </div>\n</template>\n\n<script>\nimport swal from \"sweetalert2\";\nimport axios from \"axios\";\n\nexport default {\n  props: [\"exchange\"],\n  data() {\n    return {\n      api_key_first5: \"\",\n      api_form: {\n        api_key: \"\",\n        api_secret: \"\"\n      },\n      do_auto_buy_bnb: false,\n      trade_engine_on: false,\n      backend_status: {\n        message: \"\"\n      }\n    };\n  },\n  computed: {\n    tradeEngineEnabled: {\n      get: function() {\n        return this.trade_engine_on;\n      },\n      set: async function(value) {\n        try {\n          await axios.put(\"/api/v1/settings/toggle-trade-engine-status\", {\n            exchange: this.exchange,\n            status: value\n          });\n        } catch (error) {\n          swal({\n            title: \"API keys error\",\n            text: error.response.data,\n            type: \"error\"\n          });\n\n          this.trade_engine_on = !value;\n          return false;\n        }\n      }\n    },\n    doAutoBuyBNB: {\n      get: function() {\n        return this.do_auto_buy_bnb;\n      },\n      set: async function(value) {\n        try {\n          await axios.put(\"/api/v1/settings/toggle-auto-acquire-bnb\", {\n            status: value\n          });\n        } catch (error) {\n          swal({\n            title: \"Error\",\n            text: \"Error setting auto buy BNB\",\n            type: \"error\"\n          });\n\n          this.do_auto_buy_bnb = !value;\n          return false;\n        }\n      }\n    }\n  },\n  mounted: async function() {\n    axios.get(\"/api/v1/settings/api-key/\" + this.exchange).then(res => {\n      if (res.data.pivot) {\n        // We have some settings found for this exchange\n        this.api_key_first5 = res.data.pivot.api_key_first5;\n      }\n    });\n    axios\n      .get(\"/api/v1/settings/trade-engine-status/\" + this.exchange)\n      .then(res => {\n        this.trade_engine_on = res.data.trade_engine_on;\n      });\n    axios\n      .get(\"api/v1/settings/user-backend-status/\" + this.exchange)\n      .then(res => {\n        this.backend_status.message = res.data.status_message;\n      });\n\n    if (this.exchange === \"Binance\") {\n      axios.get(\"/api/v1/settings/auto-acquire-bnb-status\").then(res => {\n        this.do_auto_buy_bnb = res.data;\n      });\n    }\n  },\n  methods: {\n    infoAlert: async function(title, text) {\n      await swal({\n        title: title,\n        html: text,\n        type: \"info\"\n      });\n    },\n    updateApiSettings: async function() {\n      // do api call\n      try {\n        const { data } = await axios.put(\"/api/v1/settings/api-key\", {\n          api_key: this.api_form.api_key,\n          api_secret: this.api_form.api_secret,\n          trade_engine_on: this.trade_engine_on,\n          exchange_name: this.exchange\n        });\n\n        this.api_key_first5 = this.api_form.api_key.slice(0, 5);\n\n        // dispatch method\n        swal({\n          title: \"API keys updated\",\n          text: data,\n          type: \"warning\"\n        });\n\n        await this.$store.dispatch(\"auth/fetchUser\");\n      } catch (error) {\n        swal({\n          title: \"API keys error\",\n          text: error.response.data,\n          type: \"error\"\n        });\n\n        return false;\n      }\n    }\n  }\n};\n</script>