ress }}</em>\n              </p>\n            </div>\n            <div v-else>\n              <p>\n                Please generate a deposit address below if you wish to do so.\n              </p>\n              <p>\n                <v-btn\n                  color=\"primary\"\n                  :loading=\"this.isAssigningEthAddress\"\n                  @click=\"assignEthAddress\"\n                >\n                  Generate a deposit address\n                </v-btn>\n              </p>\n            </div>\n          </v-card-text>\n        </v-card>\n\n        <v-card>\n          <v-toolbar card>\n            <v-toolbar-title>2FA settings</v-toolbar-title>\n          </v-toolbar>\n\n          <v-card-text>\n            <TwoFactorEnable v-if=\"!user.google_2fa_enabled\"></TwoFactorEnable>\n            <TwoFactorDisable v-else></TwoFactorDisable>\n          </v-card-text>\n        </v-card>\n\n        <v-card class=\"mt-3\">\n          <v-toolbar card>\n            <v-toolbar-title>Reset your password</v-toolbar-title>\n          </v-toolbar>\n\n          <v-card-text>\n            <v-text-field\n              v-model=\"old_password\"\n              label=\"Old password\"\n              name=\"old_password\"\n              type=\"password\"\n              value=\"old_password\"\n              prepend-icon=\"fa-unlock\"\n            ></v-text-field>\n            <v-text-field\n              v-model=\"new_password\"\n              label=\"New password\"\n              name=\"new_password\"\n              type=\"password\"\n              value=\"new_password\"\n              prepend-icon=\"fa-unlock\"\n            ></v-text-field>\n            <v-text-field\n              v-model=\"new_password_confirmation\"\n              label=\"Confirm new password\"\n              name=\"new_password_confirmation\"\n              type=\"password\"\n              value=\"new_password_confirmation\"\n              prepend-icon=\"fa-unlock\"\n            ></v-text-field>\n          