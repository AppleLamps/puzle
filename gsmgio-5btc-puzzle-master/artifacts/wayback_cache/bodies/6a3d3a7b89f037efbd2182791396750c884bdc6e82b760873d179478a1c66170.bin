        Historic buy orders used to acquire the currently reserved\n        {{ market ? market.name : \"\" }}.\n      </v-toolbar-title>\n    </v-toolbar>\n    <v-card>\n      <v-card-text>\n        <v-data-table\n          :items=\"orders || []\"\n          :headers=\"tableHeaders\"\n          :loading=\"loading\"\n          class=\"mb-2\"\n        >\n          <template slot=\"items\" slot-scope=\"props\">\n            <tr>\n              <td>{{ props.item.ts_opened_utc | formatDate }}</td>\n              <td>{{ props.item.ts_closed_utc | formatDate }}</td>\n              <td>{{ props.item.price | roundCryptoPrice }}</td>\n              <td>{{ props.item.quantity | roundQuantity }}</td>\n              <td>\n                <v-checkbox\n                  v-model=\"props.item.release\"\n                  hide-details\n                  primary\n                ></v-checkbox>\n              </td>\n            </tr>\n          </template>\n        </v-data-table>\n\n        <p class=\"body-2 font-weight-bold\">\n          To be removed: {{ total_released | roundQuantity }}\n          {{ market ? market.target_currency : \"\" }}\n        </p>\n      </v-card-text>\n      <v-card-actions class=\"pa-3\">\n        <v-icon @click=\"openHelpPage\">fa-info-circle</v-icon>\n        <v-spacer></v-spacer>\n        <v-btn flat primary @click=\"selectDeselectAllFunds\">\n          <span v-if=\"!this.allSelected\">\n            Select all\n          </span>\n          <span v-else>\n            Deselect all\n          </span>\n        </v-btn>\n        <v-btn\n          flat\n          primary\n          :disabled=\"this.total_released === 0\"\n          @click=\"releaseFunds\"\n          >Remove selected orders\n        </v-btn>\n      </v-card-actions>\n    </v-card>\n  </v-dialog>\n</template>\n\n<script>\nimport axios from \"axios\";\nimport swal from \"sweetalert2\";\nimport { bugsnagClient } from \"~/plugins\";\nimport moment from \"moment-timezone/builds/moment-timezone-with-data-10-year-range\";\n\nconst timezone = moment()\n  .tz(moment.tz.guess())\n  .format(\"z\");\n\nexport default {\n  props: {\n    value: {\n      type: Boolean,\n      default: false\n    },\n    market: {}\n  },\n  data: function() {\n    return {\n      allSelected: false,\n      tableHeaders: [\n        {\n          text: `Opened time (${timezone})`,\n          value: \"ts_opened_utc\"\n        },\n        {\n          text: `Closed time (${timezone})`,\n          value: \"ts_closed_utc\"\n        },\n        {\n          text: \"Price\",\n          value: \"price\"\n        },\n        {\n          text: \"Quantity\",\n          value: \"quantity\"\n        },\n        {\n          text: \"Remove\",\n          value: null,\n          sortable: false\n        }\n      ],\n      orders: null,\n      release_checkboxes: [],\n      loading: true\n    };\n  },\n  computed: {\n    total: function() {\n      if (this.orders) {\n        return this.orders.reduce((total, order) => {\n          return total + order.quantity;\n        }, 0);\n      }\n\n      return 0;\n    },\n    total_released: function() {\n      if (this.orders) {\n        return this.orders\n          .filter(order => order.release)\n          .reduce((total, order) => {\n            return total + order.quantity;\n          }, 0);\n      }\n\n      return 0;\n    }\n  },\n  watch: {\n    market: function(newMarket, oldMarket) {\n      this.loadOrders(newMarket);\n      this.allSelected = false;\n    }\n  },\n  methods: {\n    openHelpPage: () => {\n      const url = \"https://help.gsmg.io/en/articles/2506867-release-funds\";\n      window.open(url, \"_blank\");\n    },\n    loadOrders: async function(market) {\n      this.loading = true;\n      this.orders = null;\n\n      if (market === null) {\n        return;\n      }\n\n      try {\n        const response = await axios.get(\n          \"/api/v1/markets/\" + market.name + \"/reserved-buy-orders\"\n        );\n\n        this.orders = response.data;\n        this.loading = false;\n      } catch (error) {\n        await swal({\n          title: \"Problem getting buy orders\",\n          type: \"error\"\n        });\n\n        bugsnagClient.notify(error);\n      }\n    },\n    infoAlert: async function(title, text) {\n      await swal({\n        title: title,\n        html: text,\n        type: \"info\"\n      });\n    },\n    input(newval) {\n      this.$emit(\"input\", newval);\n    },\n    sendRequest: async function(order_ids) {\n      try {\n        await axios.post(\n          \"/api/v1/markets/\" + this.market.name + \"/release-buy-orders\",\n          {\n            order_ids: order_ids\n          }\n        );\n\n        this.$emit(\"input\", false);\n      } catch (error) {\n        let reason;\n        if (error.response.data.toString()) {\n          reason = error.response.data.toString();\n        } else {\n          reason = \"Please try again later.\";\n        }\n\n        await swal({\n          title: \"Problem releasing funds\",\n          html: reason,\n          type: \"error\"\n        });\n\n        bugsnagClient.notify(error);\n      }\n    },\n    selectDeselectAllFunds: async function() {\n      for (let order of this.orders) {\n        order.release = !this.allSelected;\n      }\n\n      this.allSelected = !this.allSelected;\n    },\n    releaseFunds: async function() {\n      const order_ids = this.orders\n        .filter(order => order.release)\n        .map(order => order.id);\n\n      if (!order_ids || order_ids.length === 0) {\n        await swal({\n          title:\n            \"No orders have been selected, please select one or more orders to release.\",\n          type: \"warning\"\n        });\n\n        return;\n      }\n\n      let confirm = await swal({\n        title: \"Warning\",\n        html: `<p>Please conform that you want to release ${this.$options.filters.roundQuantity(\n          this.total_released\n        )} ${this.market.target_currency} from ${\n       