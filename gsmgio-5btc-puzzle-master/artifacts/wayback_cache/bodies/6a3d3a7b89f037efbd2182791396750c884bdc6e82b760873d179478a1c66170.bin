ome markets (on the\n        <router-link :to=\"{ name: 'markets' }\">markets</router-link>page). You\n        can start the trade engine after activation.\n      </v-alert>\n\n      <v-flex xs12 lg3 md3>\n        <h2 class=\"title mt-4 mb-2\">Account</h2>\n        <v-card>\n          <v-card-text>\n            <v-list>\n              <v-list-tile>\n                <v-list-tile-content>\n                  <v-list-tile-title>\n                    Subscription:\n                  </v-list-tile-title>\n                  <v-list-tile-sub-title>\n                    {{ user.subscription_name }}\n                    <v-icon color=\"amber accent-3\" v-if=\"user.lifetime_free\"\n                      >fa-trophy</v-icon\n                    >\n                  </v-list-tile-sub-title>\n                </v-list-tile-content>\n              </v-list-tile>\n              <v-list-tile>\n                <v-list-tile-content>\n                  <v-list-tile-title>\n                    <span\n                      v-if=\"\n                        subscription.gsmg_fee_pct_per_trade === 0 &&\n                          !user.lifetime_free\n                      \"\n                    >\n                      Expiry date:\n                    </span>\n                    <span v-if=\"subscription.gsmg_fee_pct_per_trade > 0\">\n                      Account fuel:\n                    </span>\n                  </v-list-tile-title>\n                  <v-list-tile-sub-title>\n                    <span v-if=\"subscription.gsmg_fee_pct_per_trade === 0\">\n                      {{\n                        user.subscription_expiry_date_utc\n                          | formatDate(\"DD-MMM-YYYY HH:mm:ss z\")\n                      }}\n                    </span>\n                    <span v-if=\"subscription.gsmg_fee_pct_per_trade > 0\">\n                      {{ user.credit_eth.toFixed(5) }} ETH left\n                    </span>\n                  </v-list-tile-sub-title>\n                <